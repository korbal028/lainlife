{* блок «Время публикации»: день из календаря и время из полей со списками складываются в postpone_at в al_wall.js *}
<div class="postpone-box" style="display: none;">
    <div class="postpone-title">
        <img class="postpone-clock" src="/assets/packages/static/openvk/img/clock.svg" width="15" height="15" alt="" />
        <span>{_postpone_time_title}</span>
        <a href="javascript:void(0)" class="postpone-cancel" title="{_cancel}"><svg viewBox="0 0 10 10" width="11" height="11" aria-hidden="true"><path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-width="2.4" stroke-linecap="round" /></svg></a>
    </div>
    <div class="postpone-row">
        <a href="javascript:void(0)" class="postpone-date" title="{_postpone_choose_date}">
            <span class="postpone-date-text"></span>
            <img class="postpone-date-icon" src="/assets/packages/static/openvk/img/calendar.svg" width="16" height="17" alt="" />
        </a>
        <span class="postpone-word">{trim(tr("time_at_sp"))}</span>
        <span class="postpone-time"><input type="text" class="postpone-hour" inputmode="numeric" maxlength="2" autocomplete="off" data-max="23" /></span>
        <span class="postpone-word">:</span>
        <span class="postpone-time"><input type="text" class="postpone-minute" inputmode="numeric" maxlength="2" autocomplete="off" data-max="59" /></span>
    </div>
    <input type="hidden" name="postpone_at" value="" autocomplete="off" />
</div>
