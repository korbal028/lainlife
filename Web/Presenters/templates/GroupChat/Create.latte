{extends "../@layout.latte"}
{block title}Создать беседу{/block}
{block header}Создать беседу{/block}

{block wrap}
    <div style="padding: 10px;">
        <form method="post" action="/im/convs/create" enctype="multipart/form-data">
            <input type="hidden" name="hash" value="{$csrfToken}" />
            <div style="margin-bottom: 10px;">
                <label>Название беседы:</label><br/>
                <input type="text" name="name" placeholder="Введите название" style="width: 300px;" required />
            </div>
            <div style="margin-bottom: 15px;">
                <label>Добавить участников из друзей:</label><br/>
                {foreach $friends as $friend}
                    <label style="display: flex; align-items: center; gap: 8px; padding: 5px; cursor: pointer;">
                        <input type="checkbox" name="members[]" value="{$friend->getId()}" />
                        <img src="{$friend->getAvatarUrl('miniscule')}" style="width: 28px; height: 28px; border-radius: 50%;" />
                        <span>{$friend->getCanonicalName()}</span>
                    </label>
                {/foreach}
            </div>
            <button type="submit" class="button">Создать</button>
            <a href="/im/convs" style="margin-left: 10px;">Отмена</a>
        </form>
    </div>
{/block}
