{var $GroupChat = openvk\Web\Models\Entities\GroupChat::class}
{foreach $corresps as $coresp}
{var $recipient = $coresp->getCorrespondents()[1]}
{var $isChat    = $recipient instanceof $GroupChat}
{var $lastMsg   = $coresp->getPreviewMessage()}
{var $sel       = $coresp->getID()}
{var $isSaved   = !$isChat && $recipient->getId() === $thisUser->getId()}
{var $settings  = $dialogSettings[$sel] ?? ["pinned" => 0, "muted" => 0]}
<div n:class="scroll_node, crp-entry, $settings['pinned'] ? pinned, $settings['muted'] ? muted"
     data-im-url="{$coresp->getURL()}"
     data-sel="{$sel}"
     data-chat="{(int) $isChat}"
     data-name="{$isSaved ? tr('saved_messages') : $recipient->getCanonicalName()}"
     data-self="{(int) $isSaved}"
     onmousedown="if(event.button === 0 && !this.classList.contains('pinned')) window.router.navigate({$coresp->getURL()});" >

    <div class="crp-entry--image">
        {if $isSaved}
            <img src="{($theme ?? null)?->getSavedMessagesAvatar() ?? '/assets/packages/static/openvk/img/im/saved_messages.png'}"
            alt="{_saved_messages}" loading=lazy />
        {else}
            <img src="{$recipient->getAvatarURL('miniscule')}"
            alt="Фотография пользователя" loading=lazy />
        {/if}
    </div>
    <div class="crp-entry--info">
        {if $isSaved}
            <a href="{$coresp->getURL()}">{_saved_messages}</a><br/>
        {else}
            <a href="{$recipient->getURL()}">{$recipient->getCanonicalName()}</a><br/>
        {/if}
        <span>{$lastMsg ? $lastMsg->getSendTimeHumanized() : $recipient->getCreatedTime()->format("%d.%m.%y")}</span>
    </div>
    <div n:class="crp-entry--message, !$isSaved && $lastMsg?->isUnread() ? unread">
        {var $_author = $lastMsg?->getSender()}

        <div class="crp-entry--message---av" n:if="!$isSaved && $_author instanceof \openvk\Web\Models\Entities\User && $_author->getId() === $thisUser->getId()">
            <img src="{$_author->getAvatarURL('miniscule')}"
            alt="Фотография пользователя" />
        </div>
        <div class="crp-entry--message---text">
            {$lastMsg?->getPreviewText()|noescape}
        </div>
    </div>
    <div class="crp-entry--status">
        <img n:if="$settings['pinned']" src="/assets/packages/static/openvk/img/pin.png" title="{_messenger_chat_pinned}" />
        <span class="crp-entry--muted-icon" title="{_messenger_chat_muted}"></span>
    </div>
    <div n:if="!($hideMenu ?? false)" class="crp-entry--menu" onmousedown="event.stopPropagation();">
        <div class="crp-entry--menu-dots">&#8943;</div>
    </div>
</div>
{/foreach}
