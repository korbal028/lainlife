{extends "../@layout.latte"}
{block title}{if !$isGroupChat && $correspondent->getId() === $thisUser->getId()}{_saved_messages}{else}{$correspondent->getCanonicalName()}{/if}{/block}

{block header}
    
<a href="/im">{_my_messages}</a> »
{if !$isGroupChat && $correspondent->getId() === $thisUser->getId()}
    {_saved_messages}
{elseif $isGroupChat}
    {$correspondent->getCanonicalName()}
{else}
<a href="{$correspondent->getURL()}">{$correspondent->getCanonicalName()}</a>    
{/if}
    <div class="im-header-right">
        <div n:if="$isGroupChat" class="im-header-online">
            <span>{tr("participants", $correspondent->getParticipantsCount())}</span>
        </div>
        <div n:if="!$isGroupChat && $correspondent->getId() !== $thisUser->getId() && ($online = $correspondent->getOnline()->timestamp()) + 2505600 > time()" class="im-header-online">
            {var $diff = date_diff(date_create(), date_create('@' . $online))}
            {if 5 >= $diff->i}
                <span><b>{_online}</b></span>
            {else}
                <span>{$correspondent->isFemale() ? tr("was_online_f") : tr("was_online_m")} {$correspondent->getOnline()}</span>
            {/if}
        </div>
        <a class="im-search-btn" title="{_messenger_search_in_chat}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>
        </a>
        <a class="im-calendar-btn" title="{_messenger_go_to_date}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2"/><path d="M16 2.5v4M8 2.5v4M3 10h18M7.5 14h2M11 14h2M14.5 14h2M7.5 17.5h2M11 17.5h2"/></svg>
        </a>
        <a class="im-peer-info-btn" title="{_messenger_chat_info}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
        </a>
    </div>
{/block}

{block wrap}
    {* im-loading прячет разметку шаблонов, пока скрипт не построит ленту *}
    <div class="messenger-app im-loading">
        <div class="im-chat-loader"></div>
        <div class="messenger-app--selection" style="display: none;" data-bind="visible: selectedMsgs().length > 0">
            <span data-bind="text: selectionLabel()"></span>
            <div class="messenger-app--selection---actions">
                <a class="button" data-bind="visible: selectedMsgs().length === 1, text: pinnedMsg()?.uuid === selectedMsgs()[0] ? window.MSG_STR.unpin : window.MSG_STR.pin, click: () => { window.Msg.pinMessage(selectedMsgs()[0]); selectedMsgs.removeAll(); }"></a>
                <a class="button" data-bind="click: () => window.Msg.forwardMessages(selectedMsgs())">{_messenger_forward}</a>
                <a class="button" data-bind="click: () => window.Msg.deleteMessages(selectedMsgs())">{_messenger_delete}</a>
                <a class="messenger-app--selection---cancel" data-bind="click: () => selectedMsgs.removeAll()">{_messenger_cancel_selection}</a>
            </div>
        </div>
        <!-- ko with: pinnedMsg -->
        <div class="messenger-app--pinned" data-bind="visible: $root.selectedMsgs().length === 0, click: () => window.Msg.scrollToMessage(uuid)">
            <div class="messenger-app--pinned---icon"></div>
            <div class="messenger-app--pinned---body">
                <b>{_messenger_pinned_message}</b>
                <span class="messenger-app--pinned---sender" data-bind="text: sender.name"></span>
                <div class="messenger-app--pinned---text" data-bind="html: text || '…'"></div>
            </div>
            <a class="messenger-app--pinned---close" title="{_messenger_unpin_message}" data-bind="click: () => window.Msg.pinMessage(0), clickBubble: false">✕</a>
        </div>
        <!-- /ko -->
        <div class="messenger-app--messages" data-bind="event: { scroll: onMessagesScroll }">
            <div class="im_floating_date_wrap"><b></b></div>
            <div class="messenger-app--messages-array" data-bind="foreach: messages">
                <!-- ko if: window.isMsgNewDay($index()) -->
                <div class="messenger-app--messages-day-time"><b data-bind="text: window.msgDay(timing.ts)"></b></div>
                <!-- /ko -->
                <div class="messenger-app--messages---message" data-bind="attr: { 'data-uuid': $data.uuid }, css: { unread: !read, grouped: window.isMsgGrouped($index()), selected: $root.selectedMsgs.indexOf($data.uuid) !== -1, 'msg-replying-to': $root.replyTo() && $root.replyTo().uuid === $data.uuid }">
                    <div class="msg-check" data-bind="visible: $data.uuid > 0"></div>
                    <img class="ava" data-bind="attr: { src: sender.avatar, alt: sender.name }" />
                    <div class="_content">
                        <!-- ko ifnot: window.isMsgGrouped($index()) -->
                        <a href="#" data-bind="attr: { href: sender.link }">
                            <strong data-bind="text: sender.name"></strong>
                        </a>
                        <!-- /ko -->
                        <!-- ko if: $data.reply -->
                        <div class="reply-msg-container" data-bind="click: (d, e) => window.Msg.onReplyClick(reply, e), clickBubble: false">
                            <div class="reply-msg-head">
                                <a class="reply-avatar-link" data-bind="attr: { href: reply.sender.link }"><img class="reply-avatar" data-bind="attr: { src: reply.sender.avatar, alt: reply.sender.name }" /></a>
                                <a class="reply-author-name" data-bind="attr: { href: reply.sender.link }"><strong data-bind="text: reply.sender.name"></strong></a>
                                <span class="reply-date" data-bind="text: window.msgFullDate(reply.ts)"></span>
                            </div>
                            <!-- ko if: reply.deleted -->
                            <div class="reply-text reply-no-text">{_messenger_message_deleted}</div>
                            <!-- /ko -->
                            <!-- ko ifnot: reply.deleted -->
                            <div class="reply-text" data-bind="html: reply.text || window.MSG_STR.noText, css: { 'reply-no-text': !reply.text }"></div>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                        <span class="text" data-bind="html: text"></span>
                        <!-- ko template: 'msg-attachments-tpl' --><!-- /ko -->
                        <!-- ko if: $data.fwd && fwd.length -->
                        <div class="fwd-messages-count" data-bind="text: window.fwdCountLabel(fwd.length)"></div>
                        <div class="fwd-messages-container" data-bind="template: { name: 'msg-fwd-tpl', foreach: fwd }"></div>
                        <!-- /ko -->
                        <!-- ko if: $data.reactions && reactions.length -->
                        <div class="msg-reactions avatar-style-{$thisUser->getStyleAvatar()}" data-bind="foreach: reactions">
                            <a class="msg-reaction" data-bind="css: { mine: users.some(u => u.id === {$thisUser->getId()}) }, attr: { title: users.map(u => u.name).join(', ') }">
                                <span class="msg-reaction--emoji" data-bind="html: emoji_span(emoji)"></span>
                                <span class="msg-reaction--users" data-bind="foreach: users">
                                    <img class="msg-reaction--ava" data-bind="attr: { src: avatar, alt: name }, style: { zIndex: $parent.users.length - $index() }" />
                                </span>
                            </a>
                        </div>
                        <!-- /ko -->
                    </div>
                    <div class="msg-tools">
                        <!-- ko if: $data.uuid > 0 -->
                        <a class="msg-tool msg-tool-reply" data-act="reply" title="{_messenger_reply}"></a>
                        <!-- ko if: sender.id === {$thisUser->getId()} && !attachments.some(a => a.type === 'sticker') -->
                        <a class="msg-tool msg-tool-edit" data-act="edit" title="{_messenger_edit_message}"></a>
                        <!-- /ko -->
                        <a class="msg-tool msg-tool-more" data-act="more" title="{_messenger_more}">&#8943;</a>
                        <!-- /ko -->
                    </div>
                    <div class="time" align="right">
                        <span data-bind="html: window.msgTime($data)"></span>
                    </div>
                </div>
            </div>
            <div class="messenger-app--typing-status" style="display:none;opacity:0;">
                {tr('message_user_typing', $isGroupChat ? '' : $correspondent->getFirstName())}
            </div>
            <a class="im-jump-bottom" title="{_messenger_jump_to_recent}"></a>
        </div>
        <div id="messenger-attachment-preview" style="margin: 8px 12px; display: none;">
            <div class="post-horizontal" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
            <div class="post-vertical" style="margin-top: 8px; display: flex; flex-direction: column; gap: 8px;"></div>
        </div>
        <div class="messenger-app--input" data-bind="css: { 'with-reply': replyTo() || forwardMsgs().length }">
            {if $isGroupChat || $correspondent->getId() === $thisUser->getId() || $correspondent->getPrivacyPermission('messages.write', $thisUser)}
                <img class="ava" src="{$thisUser->getAvatarUrl('miniscule')}" alt="{$thisUser->getCanonicalName()}" />
                <div class="messenger-app--input---messagebox">
                    <div id="write" class='model_content_textarea' data-id="{$thisUser->getId()}">
                        <form action="/" method="post" enctype="multipart/form-data" style="margin:0;">
                            <a class="js-emoji-picker emoji-btn" data-tabs="emoji stickers gifs" title="{_smiles}"></a>
                            <textarea id="wall-post-input-messenger" placeholder="{_enter_message}" name="message" style="width: 100%;resize: none;" class="small-textarea expanded-textarea" autocomplete="off" data-bind="value: messageContent, event: { keydown: onTextareaKeyPress, input: onTextareaInput }"></textarea>

                            <!-- ko if: replyTo() -->
                            <div class="input-reply" data-bind="click: () => window.Msg.goToMessage(replyTo().uuid)">
                                <div class="input-reply-content">
                                    <div class="input-reply-title">{_messenger_reply_to}</div>
                                    <div class="input-reply-text"><b data-bind="text: replyTo().sender.name + ':'"></b> <span data-bind="text: window.plainText(replyTo().text) || window.MSG_STR.noText"></span></div>
                                </div>
                                <a class="input-close" title="{_cancel}" data-bind="click: () => window.Msg.clearReply(), clickBubble: false">✕</a>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: forwardMsgs().length -->
                            <div class="input-reply">
                                <div class="input-reply-content">
                                    <div class="input-reply-title" data-bind="text: window.fwdCountLabel(forwardMsgs().length)"></div>
                                    <div class="input-reply-text" data-bind="foreach: forwardMsgs()">
                                        <div class="input-fwd-item"><b data-bind="text: name + ':'"></b> <span data-bind="text: text || window.MSG_STR.noText"></span></div>
                                    </div>
                                </div>
                                <a class="input-close" title="{_cancel}" data-bind="click: () => window.Msg.clearForward(), clickBubble: false">✕</a>
                            </div>
                            <!-- /ko -->

                            <div class="post-buttons" style="display: block; margin-top:-3px;">
                                <div class="post-horizontal" style="display: none;"></div>
                                <div class="post-vertical" style="display: none;"></div>

                                <input type="hidden" name="horizontal_attachments" value="" autocomplete="off" />
                                <input type="hidden" name="vertical_attachments" value="" autocomplete="off" />
                                <input type="hidden" name="poll" value="none" autocomplete="off" />
                                <input type="hidden" id="source" name="source" value="none" autocomplete="off" />
                                <input type="hidden" name="geo" value="" autocomplete="off" />
                                <input type="hidden" name="smiles" value="" autocomplete="off" />
                                <input type="hidden" name="type" value="1" autocomplete="off" />
                                <input type="hidden" name="hash" value="{$csrfToken}" />

                                <button class="button" data-bind="click: sendMessage">{_send}</button>

                                <div style="float: right; display: flex; flex-direction: column; padding-top: 5px;">
                                    <a class='menu_toggler'>
                                        {_attach}
                                    </a>
                                    <div id="wallAttachmentMenu" class="wallAttachmentMenu hidden">
                                        <a class="header menu_toggler">{_attach}</a>
                                        <a id="__photoAttachment">
                                            <img src="/assets/packages/static/openvk/img/oxygen-icons/16x16/mimetypes/application-x-egon.png" />
                                            {_photo}
                                        </a>
                                        <a id="__videoAttachment">
                                            <img src="/assets/packages/static/openvk/img/oxygen-icons/16x16/mimetypes/application-vnd.rn-realmedia.png" />
                                            {_video}
                                        </a>
                                        <a id="__audioAttachment">
                                            <img src="/assets/packages/static/openvk/img/oxygen-icons/16x16/mimetypes/audio-ac3.png" />
                                            {_audio}
                                        </a>
                                        <a id="__documentAttachment">
                                            <img src="/assets/packages/static/openvk/img/oxygen-icons/16x16/mimetypes/application-octet-stream.png" />
                                            {_document}
                                        </a>
                                        <a id="__notesAttachment">
                                            <img src="/assets/packages/static/openvk/img/oxygen-icons/16x16/mimetypes/application-x-srt.png" />
                                            {_note}
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <img class="ava" src="{$correspondent->getAvatarUrl('miniscule')}" alt="{$correspondent->getCanonicalName()}" />
            {else}
                <div class="blocked" data-localized-text="{_messages_blocked}"></div>
            {/if}
        </div>
    </div>
    
    <template id="msg-attachments-tpl">
        <div data-bind="foreach: attachments" class="attachments">
            <div class="msg-attach-j">
                <div data-bind="if: type === 'sticker'" class="msg-attach-j-sticker">
                    <a class="msg-sticker" data-bind="attr: { 'data-pack': sticker.pack, title: sticker.emoji }"><img data-bind="attr: { src: sticker.url, alt: sticker.emoji }" /></a>
                </div>
                <div data-bind="if: type === 'photo'" class="msg-attach-j-photo">
                    <a data-bind="attr: { href: link, 'data-photo-id': id }" class="photoMessengerOpen">
                        <img data-bind="attr: { src: photo.url, alt: photo.caption }" />
                    </a>
                </div>
                <div data-bind="if: type === 'video'" class="msg-attach-j-video">
                    <div style="width: 100%; max-width: 400px; background: #000;">
                        <div class="bsdn media" data-bind="attr: { 'data-name': video.name, 'data-author': video.author }" style="width: 100%;">
                            <video class="media" data-bind="attr: { src: video.url }" style="width: 100%; display: block;"></video>
                        </div>
                    </div>
                    <div class="video-wowzer" style="margin-top: 8px;">
                        <div class="small-video-ico"></div>
                        <a data-bind="attr: { href: link, 'data-video-id': id }, text: video.name" class="videoMessengerOpen" style="display: inline-block;"></a>
                        <span class="video-wowzer-length" data-bind="text: '(' + video.formatted_length + ')'"></span>
                    </div>
                </div>
                <div data-bind="if: type === 'audio'" class="msg-attach-j-audio">
                    <div style="width:100%;">
                        <div data-bind="html: html"></div>
                    </div>
                </div>
                <div data-bind="if: type === 'note'" class="msg-attach-j-note">
                    <div data-bind="attr: { 'data-att-type': 'note', 'data-att-id': id }">
                        <div class="attachment_note">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 10"><polygon points="0 0 0 10 8 10 8 4 4 4 4 0 0 0"/><polygon points="5 0 5 3 8 3 5 0"/></svg>
                            <div class='attachment_note_content' style="width: 30%">
                                <span class="attachment_note_text">{_note}</span>
                                <span class="attachment_note_name" style="white-space: nowrap">
                                    <a href="#" data-bind="click: function() { showArticle(id); return false; }, text: note.name"></a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div data-bind="if: type === 'doc'" class="msg-attach-j-doc attachment">
                    <div style="width:100%;">
                        <a data-bind="attr: { href: link, 'data-att-type': 'doc', 'data-att-id': id }" style="display:none" class="docGalleryItem viewerOpener"></a>

                        <a class="docMainItem viewerOpener docGalleryItem" 
                           data-bind="visible: document.preview && document.preview.medium, attr: { href: link, 'data-id': id }">

                            <img class="docGalleryItem_main_preview" loading="lazy" 
                                 data-bind="attr: { src: (document.preview && document.preview.medium) ? document.preview.medium : '', alt: document.name }">

                            <div class="doc_top_panel doc_shown_by_hover">
                                <div class="doc_volume_action" id="add_icon"></div>
                            </div>

                            <div class="doc_bottom_panel doc_shown_by_hover doc_content info_shown">
                                <span class="doc_bottom_panel_name noOverflow doc_name" data-bind="text: document.name"></span>
                                <span class="doc_bottom_panel_size" data-bind="text: document.size_str"></span>
                            </div>
                        </a>

                        <div class="docMainItem docListViewItem" 
                             data-bind="visible: !(document.preview && document.preview.medium), attr: { 'data-id': id }">

                            <a class="viewerOpener" data-bind="attr: { href: link }" style="margin-left: 10%;">
                                <img class="doc_icon" data-bind="visible: document.preview && document.preview.tiny, attr: { src: (document.preview && document.preview.tiny) ? document.preview.tiny : '' }">
                                <div class="doc_icon no_image" data-bind="visible: !document.preview">
                                    <span data-bind="text: document.ext" style="justify-content: center; align-items: center; display:flex;"></span>
                                </div>
                            </a>

                            <div class="doc_content noOverflow">
                                <a class="viewerOpener noOverflow" data-bind="attr: { href: link }">
                                    <b class="noOverflow doc_name" data-bind="text: document.name"></b>
                                </a>
                                <div class="doc_content_info">
                                    <span data-bind="text: document.pub_time" style="display:inline;"></span>, <span data-bind="text: document.size_str" style="display:inline;"></span>
                                </div>
                            </div>

                            <div class="doc_volume">
                                <div id="add_icon"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="msg-fwd-tpl">
        <div class="fwd-message-block">
            <div class="fwd-message-head">
                <a class="fwd-avatar-link" data-bind="attr: { href: sender.link }"><img class="fwd-avatar" data-bind="attr: { src: sender.avatar, alt: sender.name }" /></a>
                <div class="fwd-author-info">
                    <a class="fwd-author-name" data-bind="attr: { href: sender.link }"><strong data-bind="text: sender.name"></strong></a>
                    <span class="fwd-date" data-bind="text: window.msgFullDate(timing.ts)"></span>
                </div>
            </div>
            <div class="fwd-text" data-bind="html: text"></div>
            <!-- ko template: 'msg-attachments-tpl' --><!-- /ko -->
            <!-- ko if: fwd && fwd.length -->
            <div class="fwd-messages-container" data-bind="template: { name: 'msg-fwd-tpl', foreach: fwd }"></div>
            <!-- /ko -->
        </div>
    </template>

    {script "js/node_modules/knockout/build/output/knockout-latest.js"}
    {script "js/al_calendar.js"}
    <script>
        // страница может прийти через ajax-переход, поэтому всё внутри своей области видимости
        (() => {
            const IS_GROUP_CHAT = {$isGroupChat};
            const PEER_SEL = {$isGroupChat ? $correspondent->getPeerId() : ($correspondent instanceof \openvk\Web\Models\Entities\Club ? -$correspondent->getId() : $correspondent->getId())};
            const TYPING_TPL = {tr('message_user_typing', '%NAMES%')};

            window.MSG_STR = {
                pin:     {tr("messenger_pin_message")},
                unpin:   {tr("messenger_unpin_message")},
                reply:   {tr("messenger_reply")},
                forward: {tr("messenger_forward")},
                delete:  {tr("messenger_delete")},
                noText:  {tr("messenger_no_text")},
                saved:   {tr("saved_messages")},
                forwardTo: {tr("messenger_forward_to")},
                noDialogs: {tr("no_messages")},
                fwdCount: {tr("messenger_forwarded_count", "%COUNT%")},
                reactionsAll: {tr("messenger_reactions_all")},
                readBy:  {tr("messenger_read_by", "%COUNT%")},
                readNobody: {tr("messenger_read_nobody")},
            };

            // все реакции и сколько раз пользователь ставил каждую, частые идут в строку над меню
            const REACTIONS       = {$reactions};
            const REACTION_STATS  = {$reactionStats};
            const QUICK_REACTIONS = ["❤️", "👍", "🔥", "🤣", "😭", "👎"];
            const quickReactions  = () => [...new Set([
                ...Object.keys(REACTION_STATS).filter(e => REACTIONS.includes(e)).sort((a, b) => REACTION_STATS[b] - REACTION_STATS[a]),
                ...QUICK_REACTIONS,
            ])].slice(0, QUICK_REACTIONS.length);

            window.fwdCountLabel = count => window.MSG_STR.fwdCount.replace("%COUNT%", count);

            // текст сообщения без разметки, для превью над полем ввода
            window.plainText = html => new DOMParser().parseFromString(html || "", "text/html").body.textContent.trim();

            // группировка сообщений подряд от одного отправителя
            const MSG_GROUP_INTERVAL = 10 * 60;
            window.isMsgGrouped = index => {
                let msgs = window.messages();
                if(index < 1 || index >= msgs.length) return false;

                let prev = msgs[index - 1], cur = msgs[index];
                if(prev.sender.id !== cur.sender.id) return false;
                if(typeof prev.timing.ts !== "number" || typeof cur.timing.ts !== "number") return false;
                if(window.isMsgNewDay(index)) return false;

                return (cur.timing.ts - prev.timing.ts) < MSG_GROUP_INTERVAL;
            };

            // как в openvk: у сообщения всегда время, а дата — в разделителе дней и плашке сверху
            const MSG_LOCALE = {getLanguage()}.split(/[_-]/)[0];
            window.msgDay = ts => {
                const d    = new Date(ts * 1000);
                const opts = { day: "numeric", month: "long" };
                if(d.getFullYear() !== new Date().getFullYear()) opts.year = "numeric";

                try {
                    return d.toLocaleDateString(MSG_LOCALE, opts);
                } catch(e) {
                    return d.toLocaleDateString(undefined, opts);
                }
            };

            // у неотправленного превью в sent лежит крутилка, её и показываем
            window.msgTime = msg => (typeof msg.timing.ts === "number" && msg._tuid === undefined)
                ? new Date(msg.timing.ts * 1000).toTimeString().slice(0, 8)
                : msg.timing.sent;

            window.msgFullDate = ts => window.msgDay(ts) + ", " + new Date(ts * 1000).toTimeString().slice(0, 5);

            window.isMsgNewDay = index => {
                const msgs = window.messages();
                const cur  = msgs[index];
                if(!cur || typeof cur.timing.ts !== "number") return false;

                for(let i = index - 1; i > -1; i--) {
                    if(typeof msgs[i].timing.ts !== "number") continue;

                    return new Date(msgs[i].timing.ts * 1000).toDateString() !== new Date(cur.timing.ts * 1000).toDateString();
                }

                return true;
            };

            function MessengerViewModel(initialMessages = []) {
                window.messages     = ko.observableArray(initialMessages);
                window.selectedMsgs = ko.observableArray([]);
                window.pinnedMsg    = ko.observable(null);
                window.replyTo      = ko.observable(null);
                window.forwardMsgs  = ko.observableArray([]);
                this.messages       = window.messages;
                this.selectedMsgs   = window.selectedMsgs;
                this.pinnedMsg      = window.pinnedMsg;
                this.replyTo        = window.replyTo;
                this.forwardMsgs    = window.forwardMsgs;
                this.selectionLabel = ko.pureComputed(() => {tr("messenger_selected_count", "%COUNT%")}.replace("%COUNT%", this.selectedMsgs().length));
                this.messageContent = ko.observable("");
            
                this.sendMessage = model => {
                    if(model.messageContent() === "" && !document.querySelector("#write [data-att-id]") && model.forwardMsgs().length === 0) return false;
                
                    window.Msg.sendMessage(model.messageContent());
                    model.messageContent("");
                };
                this.loadHistory = _ => {
                    window.Msg._loadHistory();
                    document.body.querySelectorAll(".bsdn").forEach(el => {
                        if(!el.querySelector(".bdsn-hydrated")) {
                            bsdnInitElement(el);
                        }
                    });
                };
            
                this.onMessagesScroll   = (model, e) => {
                    if(e.target.scrollTop < 21)
                        model.loadHistory();

                    if(e.target.scrollHeight - e.target.scrollTop - e.target.clientHeight < 21)
                        window.Msg.loadNewer();

                    window.Msg.scheduleFloatingDate();
                };
                this.onTextareaKeyPress = (model, e) => {
                    if(e.which === 13) {
                        if(!e.metaKey && !e.shiftKey) {
                            let ta = u("textarea[name=message]").nodes[0];
                            ta.blur(); //Fix update
                            model.sendMessage(model);
                            ta.focus();

                            return false;
                        }
                    }

                    return true;
                };
                this.onTextareaInput = () => {
                    window.Msg.sendTypingActivity();
                    return true;
                };
            }
        
            class Messenger {
                constructor(messages = []) {
                    this.ko       = ko.applyBindings(new MessengerViewModel(messages), document.querySelector(".messenger-app"));
                    this.appEl    = document.querySelector(".messenger-app--messages");
                    this.typeEl   = document.querySelector(".messenger-app--typing-status");
                    this.offset   = 0; // курсор для обратной пагинации истории (самое старое загруженное id)
                    this.newestId = 0; // курсор для поллинга новых сообщений (самое новое известное id)
                    this.historyEnd = false;
                    this.lastSync = Math.floor(Date.now() / 1000);

                    // после перехода к сообщению или дате лента показывает кусок истории без последних сообщений
                    this.detached     = false;
                    this.newerCursor  = 0; // самое новое загруженное id, пока лента оторвана от конца
                    this.loadingNewer = false;
                    this.feed         = 0; // меняется при замене ленты, чтобы не дописать в неё устаревший ответ
                    this.jumpBtn      = document.querySelector(".im-jump-bottom");

                    this.typingTimer = null;
                    this.pollTimer   = null;

                    this.jumpBtn?.addEventListener("click", e => {
                        e.preventDefault();
                        this.detached ? this.showLatest() : this.appEl.scrollTo({ top: this.appEl.scrollHeight, behavior: "smooth" });
                    });

                    this._loadHistory();
                    this._setupPolling();
                    this.appEl.scrollTop = this.appEl.scrollHeight;
                }
            
                _loadHistory() {
                    if(this.historyEnd) return;

                    let xhr = new XMLHttpRequest();
                    xhr.open("GET", "/im/api/messages" + PEER_SEL + `/${ this.offset }.json`, false);
                    xhr.send();
                
                    let messages    = JSON.parse(xhr.responseText);
                    if(messages.length === 0) this.historyEnd = true;

                    let lastMessage = messages[messages.length - 1];
                    if(typeof lastMessage !== "undefined") this.offset = lastMessage.uuid;

                    // newestId выставляется только один раз, при первой (самой свежей) подгрузке —
                    // последующие вызовы _loadHistory() (пагинация вверх) отдают более старые сообщения
                    // и не должны сдвигать курсор поллинга назад
                    if(this.newestId === 0 && messages.length > 0) this.newestId = messages[0].uuid;

                    // сохраняем позицию, иначе после вставки скролл остаётся на 0 и история грузится цепочкой до самого верха
                    const oldTop = this.appEl.scrollTop, oldHeight = this.appEl.scrollHeight;
                    this.prependMessages(messages);
                    this.appEl.scrollTop = oldTop + (this.appEl.scrollHeight - oldHeight);
                }
            
                // Короткий поллинг вместо long-poll: раз в несколько секунд опрашиваем /im/api/sync
                // на предмет новых/изменённых/удалённых сообщений и статуса "печатает". Никакого
                // блокирующего соединения — каждый запрос почти мгновенный и не держит воркер сервера.
                _setupPolling(intervalMs = 3500) {
                    let poll = () => {
                        // ушли со страницы чата через ajax-переход
                        if(!document.body.contains(this.appEl)) return;

                        // непрочитанные в ленте: сервер ответит, какие из них уже прочитали
                        const unread = window.messages().filter(m => m.uuid > 0 && !m.read).slice(-200).map(m => m.uuid).join(",");

                        let xhr = new XMLHttpRequest();
                        xhr.open("GET", `/im/api/sync${ PEER_SEL }/${ this.newestId }.json?since=${ this.lastSync }${ unread ? "&unread=" + unread : "" }`, true);
                        xhr.onload = () => {
                            if(xhr.status === 200 && xhr.responseText) {
                                let data = null;
                                try {
                                    data = JSON.parse(xhr.responseText);
                                } catch(e) {
                                    data = null;
                                }

                                if(data) {
                                    (data.messages || []).forEach(message => {
                                        if(this.newestId >= message.uuid) return;
                                        this.newestId = message.uuid;
                                        // лента показывает старую историю — новое подтянется при прокрутке вниз
                                        if(this.detached) return;
                                        // своё отправленное/пересланное сообщение уже есть в ленте
                                        if(window.messages().some(m => m.uuid === message.uuid)) return;
                                        this.addMessage(message);
                                    });

                                    (data.edited || []).forEach(message => {
                                        let msgs = window.messages();
                                        for(let i = 0; i < msgs.length; i++) {
                                            if(msgs[i].uuid === message.uuid) {
                                                // реакции приходят повторно ещё один опрос, лишний раз не перерисовываем
                                                if(msgs[i].text === message.text && JSON.stringify(msgs[i].timing) === JSON.stringify(message.timing) && JSON.stringify(msgs[i].reactions) === JSON.stringify(message.reactions)) break;

                                                let updated = Object.assign({}, msgs[i], {
                                                    text: message.text,
                                                    timing: message.timing,
                                                    reactions: message.reactions
                                                });
                                                window.messages.splice(i, 1, updated);
                                                break;
                                            }
                                        }
                                    });
                                    if((data.edited || []).length) this.hydrateMedia();

                                    this.removeMessages(data.deleted || []);
                                    this.markRead(data.read || []);

                                    if(typeof data.pinned !== "undefined") {
                                        this.setPinned(data.pinned);
                                    }

                                    if(data.typing) {
                                        this.setTypingStatus(data.typing_names);
                                    }

                                    if(typeof data.ts === "number") {
                                        this.lastSync = data.ts;
                                    }
                                }
                            }

                            this.pollTimer = setTimeout(poll, intervalMs);
                        };
                        xhr.onerror = () => {
                            // сетевая ошибка — не долбим сервер в цикле, ждём подольше перед повтором
                            this.pollTimer = setTimeout(poll, intervalMs * 2);
                        };
                        xhr.send();
                    };
                    poll();
                }
            
                // догружаем историю, пока лента не начнёт скроллиться, иначе onMessagesScroll не сработает
                fillHistory() {
                    let loaded = false;
                    while(!this.historyEnd && this.appEl.scrollHeight <= this.appEl.clientHeight) {
                        this._loadHistory();
                        loaded = true;
                    }

                    if(loaded) this.appEl.scrollTop = this.appEl.scrollHeight;
                }

                scheduleFloatingDate() {
                    if(this._floatingDateFrame) return;

                    this._floatingDateFrame = requestAnimationFrame(() => {
                        this._floatingDateFrame = null;
                        this.updateFloatingDate();
                        this.updateJumpButton();
                    });
                }

                firstVisibleMessage() {
                    const top   = this.appEl.getBoundingClientRect().top;
                    const first = [...this.appEl.querySelectorAll(".messenger-app--messages---message")].find(el => el.getBoundingClientRect().bottom > top);

                    return first ? ko.dataFor(first) : null;
                }

                // плашка с датой первого видимого сообщения; прячется, когда сверху и так виден разделитель дня
                updateFloatingDate() {
                    const wrap = this.appEl.querySelector(".im_floating_date_wrap");
                    const top  = this.appEl.getBoundingClientRect().top;

                    const msg  = this.firstVisibleMessage();
                    const dividerAtTop = [...this.appEl.querySelectorAll(".messenger-app--messages-day-time")].some(el => {
                        const rect = el.getBoundingClientRect();
                        return rect.top >= top - 12 && rect.bottom <= top + 50;
                    });

                    if(!msg || typeof msg.timing.ts !== "number" || dividerAtTop || this.appEl.scrollHeight <= this.appEl.clientHeight) {
                        wrap.classList.remove("shown");
                        return;
                    }

                    wrap.firstElementChild.textContent = window.msgDay(msg.timing.ts);
                    wrap.classList.add("shown");
                }

                appendMessages(messages) {
                    messages.forEach(m => window.messages.push(m));
                }
            
                prependMessages(messages) {
                    messages.forEach(m => window.messages.unshift(m));
                }
            
                addMessage(message, scroll = true) {
                    // новое сообщение встаёт в конец переписки, поэтому сначала возвращаемся к последним
                    if(this.detached) this.showLatest();
                    this.appendMessages([message]);
                
                    if(scroll) {
                        this.appEl.scrollTop = this.appEl.scrollHeight;
                    }
                }
            
                // Троттлинг: шлём не чаще раза в 3 секунды, пока юзер печатает, а не на каждый keystroke
                sendTypingActivity() {
                    let now = Date.now();
                    if(this.lastTypingSentAt && now - this.lastTypingSentAt < 3000) return;
                    this.lastTypingSentAt = now;

                    let xhr = new XMLHttpRequest();
                    xhr.open("POST", "/im/api/messages" + PEER_SEL + "/typing.json", true);
                    let fd = new FormData();
                    fd.set("hash", {$csrfToken});
                    xhr.send(fd);
                }

                setTypingStatus(names = []) {
                    // в беседе печатать могут несколько человек
                    if (names.length) this.typeEl.textContent = TYPING_TPL.replace("%NAMES%", names.join(", "));
                    if (this.typeEl.style.display == "block" && this.typeTimer !== null) {
                        clearTimeout(this.typeTimer);
                    }
                    this.typeEl.style.opacity = 1;
                    this.typeEl.style.display = "block";
                    this.typeTimer = setTimeout(() => {
                        setTimeout(() => { this.typeEl.style.display = "none" }, 250);
                        this.typeEl.style.opacity = 0;
                        this.typeTimer = null;
                    }, 6000);
                }
            
                _patchMessage(tempId, message) {
                    let msgs = window.messages();
                    for(let i = msgs.length - 1; i > -1; i--) {
                        if(msgs[i]._tuid !== tempId) continue;

                        window.messages.splice(i, 1, message);
                        return;
                    }
                }
            
                _newSelfMessage(content = "...") {
                    return {
                        "sender": {
                            "id": {$thisUser->getId()},
                            "link": {$thisUser->getURL()},
                            "avatar": {$thisUser->getAvatarUrl()},
                            "name": {$thisUser->getFirstName()}
                        },
                        "timing": {
                            "sent": window.API.Service.getTime(),
                            "ts": Math.floor(Date.now() / 1000),
                            "edited": null
                        },
                        "text": content,
                        "read": false,
                        "attachments": [],
                        "reply": null,
                        "fwd": [],
                        "_tuid": Math.ceil(performance.now())
                    };
                }
            
                _newReplyMessage(content = "...") {
                    return {
                        "sender": {
                            "id": {$correspondent->getId()},
                            "link": {$correspondent->getURL()},
                            "avatar": {$correspondent->getAvatarUrl()},
                            "name": {$isGroupChat ? $correspondent->getName() : $correspondent->getFirstName()}
                        },
                        "timing": {
                            "sent": window.API.Service.getTime(),
                            "ts": Math.floor(Date.now() / 1000),
                            "edited": null
                        },
                        "text": content,
                        "read": true,
                        "attachments": [],
                        "reply": null,
                        "fwd": [],
                        "_tuid": Math.ceil(performance.now())
                    };
                }
            
                newMessage(content) {
                    let msg = this._newSelfMessage(content);
                    msg.timing.sent = "<img src=\"/assets/packages/static/openvk/img/loading_mini.gif\">";
                    this.addMessage(msg);
                
                    return msg._tuid;
                }
            
                newReply(content) {
                    let msg = this._newReplyMessage(content);
                    this.addMessage(msg);
                
                    return msg._tuid;
                }
            
                newReplies(replies) {
                    replies.forEach(this.newReply);
                }

                removeMessages(ids) {
                    if(ids.length === 0) return;

                    window.messages.remove(m => ids.includes(m.uuid));
                    window.selectedMsgs.remove(id => ids.includes(id));
                }

                setPinned(msg) {
                    const cur = window.pinnedMsg();
                    if(JSON.stringify(cur) !== JSON.stringify(msg)) window.pinnedMsg(msg);
                }

                scrollToMessage(uuid, behavior = "smooth") {
                    const el = this.appEl.querySelector(`[data-uuid="${ uuid }"]`);
                    if(!el) return;

                    el.scrollIntoView({ block: "center", behavior });
                    el.classList.add("highlighted");
                    setTimeout(() => el.classList.remove("highlighted"), 1500);
                }

                async _post(url, data = {}) {
                    const fd = new FormData();
                    fd.set("hash", {$csrfToken});
                    Object.entries(data).forEach(([k, v]) => fd.set(k, v));

                    const res = await fetch(url, { method: "POST", body: fd });
                    if(!res.ok) throw new Error(res.status);

                    return res.json();
                }

                async pinMessage(msgId) {
                    if(msgId !== 0 && window.pinnedMsg()?.uuid === msgId) msgId = 0;

                    try {
                        const res = await this._post("/im/api/messages" + PEER_SEL + "/pin.json", { msg_id: msgId });
                        this.setPinned(res.pinned);
                    } catch(e) {
                        console.error("Pin failed", e);
                    }
                }

                // прочитанные правим на месте: перерисовка сбросила бы играющее видео/аудио
                markRead(ids) {
                    ids.forEach(id => {
                        const msg = window.messages().find(m => m.uuid === id);
                        if(!msg || msg.read) return;

                        msg.read = true;
                        this.appEl.querySelector(`.messenger-app--messages---message[data-uuid="${ id }"]`)?.classList.remove("unread");
                    });
                }

                setReactions(msgId, reactions) {
                    const msgs = window.messages();
                    const i    = msgs.findIndex(m => m.uuid === msgId);
                    if(i === -1 || JSON.stringify(msgs[i].reactions) === JSON.stringify(reactions)) return;

                    window.messages.splice(i, 1, Object.assign({}, msgs[i], { reactions }));
                    this.hydrateMedia();
                }

                // та же реакция снимается, другая заменяет прежнюю; показываем сразу, не дожидаясь ответа
                async reactMessage(msgId, emoji) {
                    const msg = window.messages().find(m => m.uuid === msgId);
                    if(!msg) return;

                    const myId   = {$thisUser->getId()};
                    const before = msg.reactions || [];
                    const had    = before.some(r => r.emoji === emoji && r.users.some(u => u.id === myId));
                    const after  = before
                        .map(r => ({ emoji: r.emoji, users: r.users.filter(u => u.id !== myId) }))
                        .filter(r => r.users.length);

                    if(!had) {
                        let group = after.find(r => r.emoji === emoji);
                        if(!group) after.push(group = { emoji, users: [] });
                        group.users.push({ id: myId, name: {$thisUser->getCanonicalName()}, avatar: {$thisUser->getAvatarUrl("miniscule")} });
                        REACTION_STATS[emoji] = (REACTION_STATS[emoji] || 0) + 1;
                    }

                    this.setReactions(msgId, after);

                    try {
                        const res = await this._post(`/im/api/messages${ PEER_SEL }/${ msgId }/react.json`, { reaction: emoji });
                        this.setReactions(msgId, res.reactions);
                    } catch(e) {
                        this.setReactions(msgId, before);
                        fastError(tr("messages_error_1"));
                    }
                }

                // выбор диалога в модальном окне, затем сообщения прикрепляются к полю ввода
                async forwardMessages(msgIds) {
                    const msgs = window.messages()
                        .filter(m => msgIds.includes(m.uuid))
                        .sort((a, b) => a.uuid - b.uuid)
                        .map(m => ({ uuid: m.uuid, name: m.sender.name, text: window.plainText(m.text) }));
                    if(msgs.length === 0) return;

                    const myId = {$thisUser->getId()};
                    const box  = MessageBox(window.MSG_STR.forwardTo, `<div class="fwd-dialogs"></div>`, [{tr("cancel")}], [Function.noop], true);
                    const list = box.getNode().find(".fwd-dialogs").first();

                    // сначала обычные чаты, потом архив, подгрузка при прокрутке
                    let page = 1, archived = 0, loading = false, done = false;
                    const loadMore = async () => {
                        if(loading || done) return;
                        loading = true;

                        try {
                            const res = await (await fetch(`/im/api/dialogs.json?p=${ page }&archived=${ archived }`)).json();
                            list.insertAdjacentHTML("beforeend", res.items.map(d => `
                                <a class="fwd-dialogs--item" data-id="${ d.id }">
                                    <img src="${ escapeHtml(d.avatar) }" alt="" />
                                    <span>${ escapeHtml(d.id === myId ? window.MSG_STR.saved : d.name) }</span>
                                </a>
                            `).join(""));

                            if(res.more) {
                                page++;
                            } else if(!archived) {
                                archived = 1;
                                page = 1;
                            } else {
                                done = true;
                                if(!list.children.length) list.textContent = window.MSG_STR.noDialogs;
                            }
                        } catch(e) {
                            done = true;
                            fastError(tr("messages_error_1"));
                        }

                        loading = false;
                        if(!done && list.scrollHeight <= list.clientHeight) loadMore();
                    };

                    list.addEventListener("scroll", () => {
                        if(list.scrollTop + list.clientHeight > list.scrollHeight - 50) loadMore();
                    });
                    loadMore();

                    list.addEventListener("click", e => {
                        const item = e.target.closest(".fwd-dialogs--item");
                        if(!item) return;

                        const id = Number(item.dataset.id);
                        box.close();
                        window.selectedMsgs.removeAll();

                        if(id === PEER_SEL) {
                            window.forwardMsgs(msgs);
                            u("textarea[name=message]").nodes[0]?.focus();
                            return;
                        }

                        try {
                            sessionStorage.setItem("im.forward", JSON.stringify(msgs));
                        } catch(err) {
                            return fastError(tr("messages_error_1"));
                        }

                        window.router.navigate(`/im?sel=${ id }&forward=1`);
                    });
                }

                // пересылка, выбранная в другом диалоге
                takeForward() {
                    const params = new URLSearchParams(location.search);
                    if(!params.has("forward")) return;

                    try {
                        const msgs = JSON.parse(sessionStorage.getItem("im.forward") || "[]");
                        sessionStorage.removeItem("im.forward");
                        window.forwardMsgs(Array.isArray(msgs) ? msgs : []);
                    } catch(e) {}

                    params.delete("forward");
                    history.replaceState(history.state, "", location.pathname + "?" + params);
                }

                clearForward() {
                    window.forwardMsgs([]);
                }

                editMessage(msgId, currentText) {
                    let cleanText = currentText.replace(/<[^>]+>/g, "");
                    let body = '<textarea id="edit-msg-input" style="width:100%; height:80px; resize:vertical;">' + cleanText + '</textarea>';
                    MessageBox("Редактировать сообщение", body, ["Сохранить", "Отмена"], [
                        () => {
                            let newText = document.getElementById("edit-msg-input").value;
                            if(!newText || newText === cleanText) return;
                            let xhr = new XMLHttpRequest();
                            xhr.open("POST", "/im/api/messages" + PEER_SEL + "/" + msgId + "/edit.json", true);
                            xhr.onreadystatechange = function() {
                                if(this.readyState !== 4) return;
                                if(this.status === 200) {
                                    let updated = JSON.parse(xhr.responseText);
                                    for(let i = 0; i < window.messages().length; i++) {
                                        if(window.messages()[i].uuid === msgId) {
                                            let msg = Object.assign({}, window.messages()[i], {
                                                text: updated.text,
                                                timing: updated.timing
                                            });
                                            window.messages.splice(i, 1, msg);
                                            break;
                                        }
                                    }
                                }
                            };
                            let fd = new FormData();
                            fd.set("content", newText);
                            fd.set("hash", {$csrfToken});
                            xhr.send(fd);
                        },
                        Function.noop
                    ]);
                }

                replyMessage(msg) {
                    if(!(msg.uuid > 0)) return;

                    window.replyTo({ uuid: msg.uuid, sender: { name: msg.sender.name }, text: msg.text });
                    u("textarea[name=message]").nodes[0].focus();
                }

                clearReply() {
                    window.replyTo(null);
                }

                // клик по цитате ведёт к исходному сообщению, клик по ссылке внутри работает как обычно
                onReplyClick(reply, e) {
                    if(e.target.closest("a")) return true;

                    this.goToMessage(reply.uuid);
                }

                // сообщения нет в ленте — показываем кусок истории вокруг него
                goToMessage(uuid) {
                    if(window.messages().some(m => m.uuid === uuid)) return this.scrollToMessage(uuid);

                    return this.jump({ msg: uuid });
                }

                hydrateMedia() {
                    this.appEl.querySelectorAll(".bsdn").forEach(el => {
                        if(!el.querySelector(".bdsn-hydrated")) {
                            bsdnInitElement(el);
                        }
                    });
                }

                // переход к сообщению ({ msg }) или первому сообщению дня ({ date }); лента отрывается
                // от последних сообщений, более новые догружаются при прокрутке вниз
                async jump(params) {
                    const feed = ++this.feed;

                    let data;
                    try {
                        const res = await fetch(`/im/api/messages${ PEER_SEL }/history.json?` + new URLSearchParams(params));
                        if(!res.ok) throw new Error(res.status);
                        data = await res.json();
                    } catch(e) {
                        console.error("History jump failed", e);
                        return fastError(tr("messages_error_1"));
                    }

                    if(feed !== this.feed || !data.target || data.messages.length === 0) return;
                    if(window.messages().some(m => m.uuid === data.target)) return this.scrollToMessage(data.target);

                    window.selectedMsgs.removeAll();
                    window.messages(data.messages);

                    this.offset      = data.messages[0].uuid;
                    this.historyEnd  = data.older_end;
                    this.newerCursor = data.messages[data.messages.length - 1].uuid;
                    this.detached    = !data.newer_end;
                    // поллинг продолжит с последнего показанного: пропущенное, пока лента была оторвана, не потеряется
                    if(!this.detached) this.newestId = this.newerCursor;

                    this.hydrateMedia();

                    // само сообщение могло быть скрыто — тогда показываем следующее за ним
                    const shown = data.messages.find(m => m.uuid >= data.target) ?? data.messages[data.messages.length - 1];
                    this.scrollToMessage(shown.uuid, "auto");
                    this.updateJumpButton();
                }

                async loadNewer() {
                    if(!this.detached || this.loadingNewer) return;

                    const feed = this.feed;
                    this.loadingNewer = true;

                    try {
                        const res = await fetch(`/im/api/messages${ PEER_SEL }/history.json?after=${ this.newerCursor }`);
                        if(!res.ok) throw new Error(res.status);
                        const data = await res.json();

                        if(feed === this.feed && this.detached) {
                            const fresh = data.messages.filter(m => !window.messages().some(x => x.uuid === m.uuid));
                            if(fresh.length) window.messages.push(...fresh);
                            if(data.messages.length) this.newerCursor = data.messages[data.messages.length - 1].uuid;

                            if(data.newer_end) {
                                this.detached = false;
                                this.newestId = this.newerCursor;
                            }

                            this.hydrateMedia();
                        }
                    } catch(e) {
                        console.error("Newer messages loading failed", e);
                    }

                    this.loadingNewer = false;
                    this.updateJumpButton();
                }

                // вернуть ленту к последним сообщениям
                showLatest() {
                    if(this.detached) {
                        this.feed++;
                        window.selectedMsgs.removeAll();
                        window.messages.removeAll();

                        const newest    = this.newestId;
                        this.offset     = 0;
                        this.historyEnd = false;
                        this.detached   = false;
                        this.newestId   = 0;
                        this._loadHistory();
                        this.newestId   = Math.max(this.newestId, newest);

                        this.hydrateMedia();
                        this.fillHistory();
                    }

                    this.appEl.scrollTop = this.appEl.scrollHeight;
                    this.updateJumpButton();
                }

                // кнопка «к последним сообщениям», когда их не видно
                updateJumpButton() {
                    if(!this.jumpBtn) return;

                    const fromBottom = this.appEl.scrollHeight - this.appEl.scrollTop - this.appEl.clientHeight;
                    this.jumpBtn.classList.toggle("shown", this.detached || fromBottom > this.appEl.clientHeight);
                }

                // переход к сообщению из поиска по всем чатам: /im?sel=…&msg=…
                takeJump() {
                    const params = new URLSearchParams(location.search);
                    if(!params.has("msg")) return;

                    const uuid = Number(params.get("msg"));
                    params.delete("msg");
                    history.replaceState(history.state, "", location.pathname + "?" + params);

                    if(uuid > 0) return this.goToMessage(uuid);
                }

                deleteMessages(msgIds) {
                    msgIds = [...msgIds];
                    const isSelfChat = {$isGroupChat ? false : $correspondent->getId() === $thisUser->getId()};
                    const hasOwn = window.messages().some(m => msgIds.includes(m.uuid) && m.sender.id === {$thisUser->getId()});

                    let body = {tr("messenger_delete_messages_confirm", "%COUNT%")}.replace("%COUNT%", msgIds.length);
                    if(hasOwn && !isSelfChat) {
                        body += `<br><br><label><input type="checkbox" id="msg_delete_for_all" checked> ${ {tr("messenger_delete_for_all")} }</label>`;
                    }

                    MessageBox({tr("messenger_delete_messages_title")}, body, [{tr("messenger_delete")}, {tr("cancel")}], [
                        async () => {
                            const forAll = isSelfChat || (document.getElementById("msg_delete_for_all")?.checked ?? false);
                            try {
                                const res = await this._post("/im/api/messages" + PEER_SEL + "/delete-many.json", {
                                    ids: msgIds.join(","),
                                    for_all: forAll ? "1" : "0",
                                });
                                this.removeMessages([...res.deleted, ...res.hidden]);
                            } catch(e) {
                                console.error("Delete failed", e);
                            }
                        },
                        Function.noop
                    ]);
                }

                // стикер уходит сразу отдельным сообщением, без текста
                async sendSticker(sticker) {
                    const msg = this._newSelfMessage("");
                    msg.attachments = [{ type: "sticker", id: sticker.id, sticker: { pack: sticker.pack, url: sticker.url, emoji: sticker.emoji } }];
                    msg.timing.sent = "<img src=\"/assets/packages/static/openvk/img/loading_mini.gif\">";
                    this.addMessage(msg);

                    const fd = new FormData();
                    fd.set("hash", {$csrfToken});
                    fd.set("content", "");
                    fd.set("attachments", "sticker" + sticker.id);
                    if(window.replyTo()) {
                        fd.set("reply_to", window.replyTo().uuid);
                        this.clearReply();
                    }

                    try {
                        const res = await fetch("/im/api/messages" + PEER_SEL + "/create.json", { method: "POST", body: fd });
                        if(res.status !== 202) throw new Error(res.status);

                        const sent = await res.json();
                        // поллинг мог успеть добавить это сообщение раньше ответа
                        if(window.messages().some(m => m.uuid === sent.uuid))
                            window.messages.remove(m => m._tuid === msg._tuid);
                        else
                            this._patchMessage(msg._tuid, sent);
                    } catch(e) {
                        window.messages.remove(m => m._tuid === msg._tuid);
                        fastError(tr("messages_error_1"));
                    }
                }

                sendMessage(content) {
                    console.debug("New outcoming message. Pushing preview to local stack.");
                    let tempId = this.newMessage(encode_emojis(escapeHtml(content)));
                
                    let msgData = new FormData();
                    msgData.set("content", content);
                    msgData.set("hash", {$csrfToken});
                    if(window.replyTo()) {
                        msgData.set("reply_to", window.replyTo().uuid);
                        this.clearReply();
                    }

                    if(window.forwardMsgs().length > 0) {
                        msgData.set("forward_messages", window.forwardMsgs().map(m => m.uuid).join(","));
                        this.clearForward();
                    }

                    const writeBox = document.querySelector('.messenger-app--input #write');
                    let attachmentElements = writeBox ? writeBox.querySelectorAll("[data-att-id]") : document.querySelectorAll("[data-att-id]");
                    let attachmentIds = [];
                    if(attachmentElements && attachmentElements.length > 0) {
                        attachmentElements.forEach(el => {
                            let type = el.getAttribute("data-att-type");
                            let id = el.getAttribute("data-att-id");
                            if(type && id) {
                                attachmentIds.push(type + id);
                            }
                        });
                    }
                
                    if(attachmentIds.length > 0) {
                        msgData.set("attachments", attachmentIds.join(","));
                    }
                
                    let that = this;
                    let xhr  = new XMLHttpRequest();
                    xhr.open("POST", "/im/api/messages" + PEER_SEL + "/create.json", true);
                    xhr.onreadystatechange = (function() {
                        if(this.readyState !== 4)
                            return;
                        else if(this.status !== 202) {
                            console.error("Message was not sent.");
                            that._patchMessage(tempId, {
                                sender: {
                                    avatar: "/assets/packages/static/openvk/img/oof.apng",
                                    id: -1,
                                    link: "/support/manpages/messages/not-delivered.html",
                                    name: tr("messages_error_1")
                                },
                                text: tr("messages_error_1_description"),
                                timing: {
                                    edited: null,
                                    sent: "???",
                                    ts: null
                                },
                                read: true,
                                attachments: [],
                                reply: null,
                                fwd: [],
                                uuid: -4096
                            });
                        
                            return;
                        }
                    
                        console.debug("Message sent, updating view.");
                        let sentMessage = JSON.parse(xhr.responseText);
                        // поллинг мог успеть добавить это сообщение раньше ответа — тогда убираем превью
                        if(window.messages().some(m => m.uuid === sentMessage.uuid))
                            window.messages.remove(m => m._tuid === tempId);
                        else
                            that._patchMessage(tempId, sentMessage);
                    
                        document.body.querySelectorAll(".bsdn").forEach(el => {
                            if(!el.querySelector(".bdsn-hydrated")) {
                                bsdnInitElement(el);
                            }
                        });
                    
                        const writeBox = document.querySelector('#write');
                        if(writeBox) {
                            writeBox.querySelector('.post-horizontal').innerHTML = '';
                            writeBox.querySelector('.post-vertical').innerHTML = '';
                        }

                        const previewBox = document.querySelector('#messenger-attachment-preview');
                        if(previewBox) {
                            previewBox.querySelector('.post-horizontal').innerHTML = '';
                            previewBox.querySelector('.post-vertical').innerHTML = '';
                            previewBox.style.display = 'none';
                        }
                    });
                    xhr.send(msgData);
                    console.debug("Message sent, awaiting response.");
                }
            }
        
            window.Msg = new Messenger([]);
            window.Msg.takeForward();

            document.querySelector(".messenger-app--input #write form")?.addEventListener("sticker:send", e => {
                e.preventDefault();
                window.Msg.sendSticker(e.detail);
            });

            // лента сообщений растягивается до низа окна
            const messenger = window.Msg;
            const fitMessenger = () => {
                const list = messenger.appEl;
                const app  = list.closest(".messenger-app");
                if(!document.body.contains(list)) return window.removeEventListener("resize", fitMessenger);

                const atBottom = list.scrollHeight - list.scrollTop - list.clientHeight < 20;

                const below  = app.getBoundingClientRect().bottom - list.getBoundingClientRect().bottom;
                const height = window.innerHeight - (list.getBoundingClientRect().top + window.scrollY) - below - 25;
                list.style.height = Math.max(300, height) + "px";

                if(atBottom) list.scrollTop = list.scrollHeight;
                messenger.fillHistory();
            };

            fitMessenger();
            window.addEventListener("resize", fitMessenger);
            window.selectedMsgs.subscribe(() => setTimeout(fitMessenger));
            window.pinnedMsg.subscribe(() => setTimeout(fitMessenger));
            window.messages.subscribe(() => window.Msg.scheduleFloatingDate());
            new ResizeObserver(fitMessenger).observe(document.querySelector(".messenger-app--input"));

            const msgAction = (act, msg) => {
                switch(act) {
                    case "pin":     return window.Msg.pinMessage(msg.uuid);
                    case "edit":    return window.Msg.editMessage(msg.uuid, msg.text);
                    case "reply":   return window.Msg.replyMessage(msg);
                    case "forward": return window.Msg.forwardMessages([msg.uuid]);
                    case "delete":  return window.Msg.deleteMessages([msg.uuid]);
                }
            };

            // выделение сообщений и мини-меню
            document.querySelector(".messenger-app--messages").addEventListener("click", e => {
                const tool = e.target.closest(".msg-tool[data-act]");
                if(tool) {
                    e.preventDefault();
                    if(tool.dataset.act !== "more") msgAction(tool.dataset.act, ko.dataFor(tool));
                    return;
                }

                const reaction = e.target.closest(".msg-reaction");
                if(reaction) {
                    e.preventDefault();
                    return window.Msg.reactMessage(ko.dataFor(reaction.closest(".messenger-app--messages---message")).uuid, ko.dataFor(reaction).emoji);
                }

                const el = e.target.closest(".messenger-app--messages---message");
                if(!el || e.target.closest("a, button, video, audio, input, textarea, .bsdn, .attachments, .msg-tools, .reply-msg-container")) return;
                if(window.getSelection().toString() !== "") return;

                const uuid = ko.dataFor(el).uuid;
                if(!(uuid > 0)) return;

                window.selectedMsgs.indexOf(uuid) === -1 ? window.selectedMsgs.push(uuid) : window.selectedMsgs.remove(uuid);
            });

            // двойной клик по сообщению — ответить, как в openvk
            document.querySelector(".messenger-app--messages").addEventListener("dblclick", e => {
                const el = e.target.closest(".messenger-app--messages---message");
                if(!el || e.target.closest("a, button, video, audio, input, textarea, .bsdn, .attachments, .msg-tools, .reply-msg-container, .fwd-messages-container")) return;
                if(!document.querySelector("#write textarea")) return;

                window.getSelection().removeAllRanges();
                window.Msg.replyMessage(ko.dataFor(el));
            });

            const menuOptions = {
                animation: "up_down",
                theme: "special vk",
                content: "",
                allowHTML: true,
                interactive: true,
                trigger: "click",
                arrow: false,
                appendTo: () => document.body,
            };

            // строка частых реакций над меню, стрелка раскрывает все
            const buildReactionBar = (msg, tip, menu, context) => {
                const mine = (msg.reactions || []).find(r => r.users.some(u => u.id === {$thisUser->getId()}))?.emoji;
                const bar  = u(`
                    <div class="like_tooltip_wrapper crp-menu-tooltip msg-react-bar${ context ? " crp-menu-context" : "" }">
                        <div class="like_tooltip_body">
                            <div class="msg-react-quick"></div>
                            <span class="msg-react-more" role="button"></span>
                            <div class="msg-react-all"></div>
                        </div>
                    </div>
                `);

                const button = emoji => u(`<span class="msg-react${ emoji === mine ? " active" : "" }" role="button">${ emoji_span(emoji) }</span>`)
                    .on("click", e => {
                        e.preventDefault();
                        tip.hide();
                        window.Msg.reactMessage(msg.uuid, emoji);
                    });

                quickReactions().forEach(emoji => bar.find(".msg-react-quick").append(button(emoji)));

                bar.find(".msg-react-more").attr("title", window.MSG_STR.reactionsAll).on("click", e => {
                    e.preventDefault();
                    REACTIONS.forEach(emoji => bar.find(".msg-react-all").append(button(emoji)));
                    menu.addClass("expanded");
                    tip.popperInstance?.update();
                });

                return bar;
            };

            // кто прочитал сообщение в беседе: счётчик и аватарки как у реакций, грузится при открытии меню
            const buildReaders = (msg, tip) => {
                const row = u(`
                    <div class="msg-menu-readers avatar-style-{$thisUser->getStyleAvatar()|noescape}">
                        <span class="msg-menu-readers--count">${ window.MSG_STR.readBy.replace("%COUNT%", "…") }</span>
                        <span class="msg-menu-readers--users"></span>
                    </div>
                `);

                fetch(`/im/api/messages${ PEER_SEL }/${ msg.uuid }/readers.json`).then(res => res.ok ? res.json() : Promise.reject(res.status)).then(data => {
                    row.find(".msg-menu-readers--count").text(data.count ? window.MSG_STR.readBy.replace("%COUNT%", data.count) : window.MSG_STR.readNobody);
                    row.attr("title", data.users.map(r => r.name).join(", "));
                    data.users.slice(0, 5).forEach((r, i, shown) => {
                        const ava = u(`<img class="msg-reaction--ava">`).attr({ src: r.avatar, alt: r.name }).first();
                        ava.style.zIndex = shown.length - i;
                        row.find(".msg-menu-readers--users").append(ava);
                    });
                    if(data.count) window.Msg.markRead([msg.uuid]);
                    tip.popperInstance?.update();
                }).catch(e => {
                    console.error("Readers failed", e);
                    row.remove();
                });

                return row;
            };

            const buildMenu = (msg, tip, context = false) => {
                const isPinned = window.pinnedMsg()?.uuid === msg.uuid;
                const menu = u(`
                    <div class="msg-menu">
                        <div class="like_tooltip_wrapper crp-menu-tooltip crp-menu-context msg-menu-actions">
                            <div class="like_tooltip_body"></div>
                        </div>
                    </div>
                `);
                menu.prepend(buildReactionBar(msg, tip, menu, context));
                if(IS_GROUP_CHAT) menu.find(".msg-menu-actions .like_tooltip_body").append(buildReaders(msg, tip));

                [["pin", isPinned ? window.MSG_STR.unpin : window.MSG_STR.pin], ["forward", window.MSG_STR.forward], ["delete", window.MSG_STR.delete]].forEach(([act, text]) => {
                    const link = u(`<a></a>`).text(text);
                    if(act === "delete") link.addClass("crp-menu-danger");
                    link.on("click", e => {
                        e.preventDefault();
                        tip.hide();
                        msgAction(act, msg);
                    });
                    menu.find(".msg-menu-actions .like_tooltip_body").append(link);
                });

                return menu.first();
            };

            tippy.delegate(".messenger-app--messages", {
                ...menuOptions,
                target: ".msg-tool-more",
                placement: "bottom-end",
                offset: [0, 8],
                onShow(tip) {
                    tip.setContent(buildMenu(ko.dataFor(tip.reference), tip));
                },
            });

            // ПКМ по сообщению открывает то же меню у курсора
            const ctxTip = tippy(document.createElement("div"), {
                ...menuOptions,
                trigger: "manual",
                placement: "bottom-start",
                offset: [0, 0],
            });

            document.querySelector(".messenger-app--messages").addEventListener("contextmenu", e => {
                const el = e.target.closest(".messenger-app--messages---message");
                if(!el || e.target.closest("a, video, audio, input, textarea") || window.getSelection().toString() !== "") return;

                const msg = ko.dataFor(el);
                if(!(msg.uuid > 0)) return;

                e.preventDefault();
                const { clientX: x, clientY: y } = e;
                ctxTip.setProps({ getReferenceClientRect: () => new DOMRect(x, y, 0, 0) });
                ctxTip.setContent(buildMenu(msg, ctxTip, true));
                ctxTip.show();
            });

        
            document.querySelector(".messenger-app--messages").addEventListener("click", (e) => {
                if(e.target.closest(".photoMessengerOpen")) {
                    e.preventDefault();
                    e.stopPropagation();
                    const photoLink = e.target.closest(".photoMessengerOpen");
                    const photoId = photoLink.getAttribute("data-photo-id");
                    const photoImg = photoLink.querySelector("img");
                    if(photoImg && photoId) {
                        OpenMiniature(e, photoImg.src, null, photoId, null);
                    }
                }
            
                if(e.target.closest(".videoMessengerOpen")) {
                    e.preventDefault();
                    e.stopPropagation();
                    const videoLink = e.target.closest(".videoMessengerOpen");
                    const videoId = videoLink.getAttribute("data-video-id");
                    if(videoId && videoId.indexOf("_") !== -1) {
                        const parts = videoId.split("_");
                        OpenVideo(parts);
                    }
                }
            });

            (function() {
                function syncItemToPreview(item) {
                    if(!item) return;
                
                    const type = item.getAttribute('data-type') || item.getAttribute('data-att-type');
                    const id = item.getAttribute('data-id') || item.getAttribute('data-att-id') || item.getAttribute('data-prettiest-id') || item.getAttribute('data-pretty-id');
                
                    if(type && id) {
                        item.setAttribute('data-att-type', type);
                        item.setAttribute('data-att-id', id);
                    
                        const previewBox = document.querySelector('#messenger-attachment-preview');
                        if(previewBox) {
                            const isVertical = type === 'doc' || type === 'note' || type === 'audio';
                            const container = isVertical ? 
                                previewBox.querySelector('.post-vertical') : 
                                previewBox.querySelector('.post-horizontal');
                            if(container && !container.querySelector(`[data-att-type="${ type }"][data-att-id="${ id }"]`)) {
                                container.appendChild(item.cloneNode(true));
                                previewBox.style.display = 'block';
                            }
                        }
                    }
                }
            
                function normalizeUploadItem(el) {
                    if(!el) return;
                    const items = el.querySelectorAll('.upload-item, .vertical-attachment');
                    items.forEach(a => {
                        syncItemToPreview(a);
                    });
                }
            
                const write = document.querySelector('#write');
                if(write) normalizeUploadItem(write);
                const observer = new MutationObserver(mutations => {
                    mutations.forEach(m => {
                        if(m.addedNodes && m.addedNodes.length) {
                            m.addedNodes.forEach(node => {
                                if(node.nodeType === 1) {
                                    if(node.matches && (node.matches('.upload-item') || node.matches('.vertical-attachment'))) {
                                        syncItemToPreview(node);
                                    } else {
                                        normalizeUploadItem(node);
                                    }
                                }
                            });
                        }

                        if(m.removedNodes && m.removedNodes.length) {
                            const previewBox = document.querySelector('#messenger-attachment-preview');
                            if (!previewBox) return;

                            m.removedNodes.forEach(node => {
                                if(node.nodeType === 1 && node.matches && (node.matches('.upload-item') || node.matches('.vertical-attachment'))) {
                                    const type = node.getAttribute('data-att-type') || node.getAttribute('data-type');
                                    const id = node.getAttribute('data-att-id') || node.getAttribute('data-id');

                                    if(type && id) {
                                        const itemToRemove = previewBox.querySelector(`[data-att-type="${ type }"][data-att-id="${ id }"], [data-type="${ type }"][data-id="${ id }"]`);
                                        if(itemToRemove) {
                                            itemToRemove.remove();
                                        }
                                    }
                                }
                            });

                            if(previewBox.querySelectorAll('.upload-item, .vertical-attachment').length === 0) {
                                previewBox.style.display = 'none';
                            }
                        }
                    });
                });
                if(write) observer.observe(write, { childList: true, subtree: true });

                const previewBox = document.querySelector('#messenger-attachment-preview');
                if(previewBox) {
                    previewBox.addEventListener('click', function(e) {
                        const target = e.target;
                        const deleteBtn = target.closest('.upload-delete') || target.closest('#small_remove_button') || target.closest('.vertical-attachment-remove');

                        if(deleteBtn) {
                            e.preventDefault();
                            e.stopPropagation();

                            const item = deleteBtn.closest('.upload-item, .vertical-attachment');
                            if(item) {
                                const type = item.getAttribute('data-att-type') || item.getAttribute('data-type');
                                const id = item.getAttribute('data-att-id') || item.getAttribute('data-id');

                                if(type && id && write) {
                                    const sourceItem = write.querySelector(`[data-att-type="${ type }"][data-att-id="${ id }"], [data-type="${ type }"][data-id="${ id }"]`);
                                    if(sourceItem)
                                        sourceItem.remove();
                                }
                            }
                        }
                    });
                }

            })();

            // меню вложений и информация о собеседнике, по образу телеграма
            const PEER_STR   = {
                shortcode:  {tr("messenger_info_shortcode")},
                birthday:   {tr("messenger_info_birthday")},
                empty:      {tr("messenger_info_empty")},
                block:      {tr("messenger_block_user")},
                unblock:    {tr("messenger_unblock_user")},
                del:        {tr("messenger_delete_chat")},
                delText:    {tr("messenger_delete_chat_confirm", "%NAME%")},
                delForAll:  {tr("messenger_delete_chat_for_all", "%NAME%")},
                delForEveryone: {tr("messenger_delete_chat_for_everyone")},
                delBtn:     {tr("delete")},
                cancel:     {tr("cancel")},
                leave:      {tr("messenger_leave_chat")},
                leaveText:  {tr("messenger_leave_chat_confirm", "%NAME%")},
                leaveBtn:   {tr("messenger_leave_chat_button")},
                owner:      {tr("messenger_chat_owner")},
                admin:      {tr("messenger_chat_admin")},
                inviteHint: {tr("messenger_invite_link_hint")},
                inviteReset: {tr("messenger_invite_link_reset")},
                addMembers: {tr("messenger_add_members")},
                addBtn:     {tr("messenger_add_members_button")},
                inChat:     {tr("messenger_already_in_chat")},
                noFriends:  {tr("messenger_no_friends_to_add")},
                blockText:  {tr("adding_to_bl_sure", "%NAME%")},
                blockTitle: {tr("addition_to_bl")},
                yes:        {tr("yes")},
                no:         {tr("no")},
                title:      {tr("messenger_chat_info")},
                back:       {tr("messenger_info_back")},
                close:      {tr("close")},
                search:     {tr("messenger_search_in_chat")},
                searchHint: {tr("messenger_search_in_chat_placeholder")},
                notFound:   {tr("no_results_by_this_query")},
            };
            const OXYGEN     = "/assets/packages/static/openvk/img/oxygen-icons/64x64/";
            const KIND_ICONS = {
                photo: "mimetypes/application-x-egon.png",
                video: "mimetypes/application-vnd.rn-realmedia.png",
                doc:   "mimetypes/application-octet-stream.png",
                audio: "mimetypes/audio-ac3.png",
                gif:   "mimetypes/application-xsd.png",
            };

            const renderAttachment = (kind, item) => {
                switch(kind) {
                    case "photo":
                        return `<a class="im-peer-att--photo" href="/photo${ escapeHtml(item.id) }" data-id="${ escapeHtml(item.id) }" data-url="${ escapeHtml(item.url) }"><img src="${ escapeHtml(item.thumb) }" alt="" loading="lazy" /></a>`;
                    case "gif":
                        return `<a class="im-peer-att--photo" href="${ escapeHtml(item.link) }"><img src="${ escapeHtml(item.url) }" alt="" loading="lazy" /></a>`;
                    case "video":
                        return `
                            <a class="im-peer-att--row im-peer-att--video" data-id="${ escapeHtml(item.id) }">
                                <img src="${ escapeHtml(item.thumb) }" alt="" loading="lazy" />
                                <span class="im-peer-att--name">${ escapeHtml(item.name) }</span>
                                <span class="im-peer-att--meta">${ escapeHtml(item.length) }</span>
                            </a>`;
                    case "doc":
                        return `
                            <a class="im-peer-att--row" href="${ escapeHtml(item.link) }">
                                ${ item.preview
                                    ? `<img src="${ escapeHtml(item.preview) }" alt="" loading="lazy" />`
                                    : `<span class="im-peer-att--ext">${ escapeHtml(item.ext) }</span>` }
                                <span class="im-peer-att--name">${ escapeHtml(item.name) }</span>
                                <span class="im-peer-att--meta">${ escapeHtml(item.size) }</span>
                            </a>`;
                    case "audio":
                        return `<div class="im-peer-att--audio">${ item.html }</div>`;
                }
            };

            const openAddMembers = async () => {
                const postInvite = async act => {
                    const fd = new FormData();
                    fd.set("hash", {$csrfToken});
                    fd.set("act", act);

                    const res = await fetch(`/im/api/chat${ PEER_SEL }/invite.json`, { method: "POST", body: fd });
                    if(!res.ok) throw new Error(res.status);

                    return (await res.json()).link;
                };

                let friends, link;
                try {
                    [friends, link] = await Promise.all([
                        fetch(`/im/api/chat${ PEER_SEL }/friends.json`).then(res => res.json()),
                        postInvite("get"),
                    ]);
                } catch(e) {
                    return fastError(tr("messages_error_1"));
                }

                const list = friends.length ? friends.map(f => `
                    <label class="im-add-member">
                        <input type="checkbox" value="${ Number(f.id) }" ${ f.already_in_chat ? "checked disabled" : "" } />
                        <img class="avatar-style-${ Number(window.openvk?.avatar_style ?? 0) }" src="${ escapeHtml(f.avatar) }" alt="" loading="lazy" />
                        <span class="im-add-member--name">${ escapeHtml(f.name) }</span>
                        ${ f.already_in_chat ? `<span class="im-add-member--note">${ escapeHtml(PEER_STR.inChat) }</span>` : "" }
                    </label>`).join("") : `<div class="im-add-member--empty">${ escapeHtml(PEER_STR.noFriends) }</div>`;

                const root = MessageBox(PEER_STR.addMembers, `
                    <div class="im-invite">
                        <div class="im-invite--hint">${ escapeHtml(PEER_STR.inviteHint) }</div>
                        <input type="text" class="im-invite--link" readonly value="${ escapeHtml(link) }" onclick="this.select()" />
                        <div class="im-invite--actions">
                            <a class="button" data-act="reset">${ escapeHtml(PEER_STR.inviteReset) }</a>
                        </div>
                    </div>
                    <div class="im-add-members">${ list }</div>
                `, [PEER_STR.addBtn, PEER_STR.cancel], [async () => {
                    const ids = [...document.querySelectorAll(".im-add-members input:checked:not(:disabled)")].map(i => i.value);
                    for(const id of ids) {
                        const fd = new FormData();
                        fd.set("hash", {$csrfToken});
                        const res = await fetch(`/im/api/chat${ PEER_SEL }/add${ id }.json`, { method: "POST", body: fd });
                        if(!res.ok) fastError(tr("messages_error_1"));
                    }

                    if(ids.length) openPeerInfo();
                }, Function.noop], true).getNode().first();

                const input = root.querySelector(".im-invite--link");
                root.querySelector(".im-invite--actions").addEventListener("click", async e => {
                    const act = e.target.closest("[data-act]")?.dataset.act;
                    if(act === "reset") {
                        try {
                            input.value = await postInvite("reset");
                        } catch(err) {
                            fastError(tr("messages_error_1"));
                        }
                    }
                });
            };

            // page — раздел, с которого открыть окно: "main" или "search"
            const openPeerInfo = async (page = "main") => {
                if(document.querySelector(".im-peer-dialog")) return;

                let info;
                try {
                    info = await (await fetch(`/im/api/peer${ PEER_SEL }.json`)).json();
                } catch(e) {
                    return fastError(tr("messages_error_1"));
                }

                const avatarStyle = Number(window.openvk?.avatar_style ?? 0);
                const msg = new CMessageBox({
                    title: escapeHtml(PEER_STR.title),
                    body: `
                        <div class="im-peer-page" data-page="main">
                            <div class="im-peer-head">
                                <a href="${ escapeHtml(info.link) }"><img class="im-peer-avatar avatar-style-${ avatarStyle }" src="${ escapeHtml(info.avatar) }" alt="" /></a>
                                <a class="im-peer-name" href="${ escapeHtml(info.link) }">${ escapeHtml(info.name) }</a>
                            </div>
                            ${ info.shortcode || info.birthday ? `
                                <div class="im-peer-section">
                                    ${ info.shortcode ? `
                                        <div class="im-peer-info">
                                            <a href="${ escapeHtml(info.link) }">@${ escapeHtml(info.shortcode) }</a>
                                            <div class="im-peer-label">${ escapeHtml(PEER_STR.shortcode) }</div>
                                        </div>` : "" }
                                    ${ info.birthday ? `
                                        <div class="im-peer-info">
                                            <div>${ escapeHtml(info.birthday) }</div>
                                            <div class="im-peer-label">${ escapeHtml(PEER_STR.birthday) }</div>
                                        </div>` : "" }
                                </div>` : "" }
                            <div class="im-peer-section">
                                <a class="im-peer-row" data-act="search">
                                    <img src="${ OXYGEN }actions/document-preview.png" alt="" />
                                    <span>${ escapeHtml(PEER_STR.search) }</span>
                                </a>
                                ${ info.counts.map(c => `
                                    <a class="im-peer-row" data-kind="${ c.kind }" data-title="${ escapeHtml(c.title) }">
                                        <img src="${ OXYGEN + KIND_ICONS[c.kind] }" alt="" />
                                        <span>${ escapeHtml(c.label) }</span>
                                    </a>`).join("") }
                            </div>
                            <div class="im-peer-section">
                                <a class="im-peer-row" data-act="delete">
                                    <img src="${ OXYGEN }places/user-trash.png" alt="" />
                                    <span>${ escapeHtml(PEER_STR.del) }</span>
                                </a>
                                ${ info.blocked !== null ? `
                                    <a class="im-peer-row im-peer-danger" data-act="block">
                                        <img src="${ OXYGEN }actions/im-ban-user.png" alt="" />
                                        <span>${ escapeHtml(info.blocked ? PEER_STR.unblock : PEER_STR.block) }</span>
                                    </a>` : "" }
                                ${ info.can_leave ? `
                                    <a class="im-peer-row im-peer-danger" data-act="leave">
                                        <img src="${ OXYGEN }actions/application-exit.png" alt="" />
                                        <span>${ escapeHtml(PEER_STR.leave) }</span>
                                    </a>` : "" }
                            </div>
                            ${ info.chat ? `
                                <div class="im-peer-section">
                                    <div class="im-peer-row im-peer-members--head">
                                        <span>${ escapeHtml(info.members_label) }</span>
                                    </div>
                                    ${ info.can_invite ? `
                                        <a class="im-peer-row" data-act="add-members">
                                            <img src="${ OXYGEN }actions/list-add-user.png" alt="" />
                                            <span>${ escapeHtml(PEER_STR.addMembers) }</span>
                                        </a>` : "" }
                                    ${ info.members.map(m => `
                                        <a class="im-peer-member" href="${ escapeHtml(m.link) }">
                                            <img class="im-peer-member--ava avatar-style-${ avatarStyle }" src="${ escapeHtml(m.avatar) }" alt="" loading="lazy" />
                                            <span class="im-peer-member--name">${ escapeHtml(m.name) }</span>
                                            ${ m.role ? `<span class="im-peer-member--role">${ escapeHtml(PEER_STR[m.role]) }</span>` : "" }
                                        </a>`).join("") }
                                </div>` : "" }
                        </div>
                        <div class="im-peer-page im-peer-list" data-page="list" hidden></div>
                        <div class="im-peer-page im-peer-search" data-page="search" hidden>
                            <div class="im-peer-search--bar">
                                <input type="search" placeholder="${ escapeHtml(PEER_STR.searchHint) }" autocomplete="off" />
                            </div>
                            <div class="im-peer-search--summary" hidden></div>
                            <div class="im-peer-search--results"></div>
                        </div>
                    `,
                    buttons: [escapeHtml(PEER_STR.close)],
                    callbacks: [Function.noop],
                });

                const node = msg.getNode();
                node.addClass("im-peer-dialog");

                const root  = node.first();
                const head  = root.querySelector(".ovk-diag-head");
                const body  = root.querySelector(".ovk-diag-body");
                const main  = root.querySelector('[data-page="main"]');
                const list  = root.querySelector('[data-page="list"]');
                const found = root.querySelector('[data-page="search"]');
                const close = () => msg.close();

                // «назад» слева от «закрыть», виден только в разделе вложений
                const backBtn = u(`<button class="button im-peer-back" hidden>${ escapeHtml(PEER_STR.back) }</button>`).first();
                root.querySelector(".ovk-diag-action").prepend(backBtn);

                // подгрузка вложений выбранного типа при прокрутке
                let current = null;
                const loadMore = async () => {
                    const state = current;
                    if(!state || state.loading || state.done) return;
                    state.loading = true;

                    try {
                        const res = await (await fetch(`/im/api/peer${ PEER_SEL }/attachments.json?type=${ state.kind }&offset=${ state.offset }`)).json();
                        if(state !== current) return;

                        state.offset += res.items.length;
                        state.done = !res.more;
                        list.insertAdjacentHTML("beforeend", res.items.map(item => renderAttachment(state.kind, item)).join(""));
                        if(state.offset === 0) list.innerHTML = `<div class="im-peer-empty">${ escapeHtml(PEER_STR.empty) }</div>`;
                    } catch(e) {
                        state.done = true;
                        fastError(tr("messages_error_1"));
                    }

                    state.loading = false;
                    if(!state.done && body.scrollHeight <= body.clientHeight) loadMore();
                };

                // поиск по сообщениям чата, тоже с подгрузкой при прокрутке
                const searchInput   = found.querySelector("input");
                const searchSummary = found.querySelector(".im-peer-search--summary");
                const searchList    = found.querySelector(".im-peer-search--results");
                let search = null;

                const renderFound = item => `
                    <a class="im-search-msg" data-uuid="${ Number(item.uuid) }">
                        <img class="im-search-msg--ava" src="${ escapeHtml(item.sender.avatar) }" alt="" loading="lazy" />
                        <div class="im-search-msg--body">
                            <div class="im-search-msg--head">
                                <b>${ escapeHtml(item.sender.name) }</b>
                                <span class="im-search-msg--date">${ escapeHtml(window.msgFullDate(item.ts)) }</span>
                            </div>
                            <div class="im-search-msg--text">${ item.text }</div>
                        </div>
                    </a>`;

                const loadSearch = async () => {
                    const state = search;
                    if(!state || state.loading || state.done) return;
                    state.loading = true;

                    try {
                        const res = await (await fetch(`/im/api/messages${ PEER_SEL }/search.json?q=${ encodeURIComponent(state.q) }&offset=${ state.offset }`)).json();
                        if(state !== search) return;

                        if(res.count !== null) {
                            searchSummary.textContent = tr("messenger_search_found", res.count);
                            searchSummary.hidden = res.count === 0;
                        }

                        state.offset += res.items.length;
                        state.done = !res.more;
                        searchList.insertAdjacentHTML("beforeend", res.items.map(renderFound).join(""));
                        if(state.offset === 0) searchList.innerHTML = `<div class="im-peer-empty">${ escapeHtml(PEER_STR.notFound) }</div>`;
                    } catch(e) {
                        state.done = true;
                        fastError(tr("messages_error_1"));
                    }

                    state.loading = false;
                    if(!state.done && body.scrollHeight <= body.clientHeight) loadSearch();
                };

                let searchTimer = null;
                const startSearch = () => {
                    clearTimeout(searchTimer);

                    const q = searchInput.value.trim();
                    if((search?.q ?? "") === q) return;

                    searchList.innerHTML = "";
                    searchSummary.hidden = true;
                    search = q === "" ? null : { q, offset: 0, loading: false, done: false };
                    loadSearch();
                };

                searchInput.addEventListener("input", () => {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(startSearch, 300);
                });
                searchInput.addEventListener("keydown", e => {
                    if(e.key === "Enter") startSearch();
                });

                body.addEventListener("scroll", () => {
                    if(body.scrollTop + body.clientHeight > body.scrollHeight - 100) found.hidden ? loadMore() : loadSearch();
                });

                const showMain = () => {
                    current = null;
                    head.textContent = PEER_STR.title;
                    list.hidden = true;
                    found.hidden = true;
                    main.hidden = false;
                    backBtn.hidden = true;
                    node.removeClass("im-peer-dialog-list");
                };

                const showKind = (kind, title) => {
                    current = { kind, offset: 0, loading: false, done: false };
                    head.textContent = title;
                    list.className = `im-peer-page im-peer-list im-peer-list-${ kind }`;
                    list.innerHTML = "";
                    main.hidden = true;
                    found.hidden = true;
                    list.hidden = false;
                    backBtn.hidden = false;
                    node.addClass("im-peer-dialog-list");
                    body.scrollTop = 0;
                    loadMore();
                };

                const showSearch = () => {
                    current = null;
                    head.textContent = PEER_STR.search;
                    main.hidden = true;
                    list.hidden = true;
                    found.hidden = false;
                    backBtn.hidden = false;
                    node.addClass("im-peer-dialog-list");
                    body.scrollTop = 0;
                    searchInput.focus();
                };

                backBtn.addEventListener("click", showMain);

                const askDelete = () => {
                    close();
                    const name = escapeHtml(info.name);
                    let text = PEER_STR.delText.replace("%NAME%", name);
                    if(info.chat ? info.can_delete_for_all : !info.self) {
                        const forAll = info.chat ? PEER_STR.delForEveryone : PEER_STR.delForAll.replace("%NAME%", name);
                        text += `<br><br><label><input type="checkbox" id="im_peer_delete_for_all"> ${ forAll }</label>`;
                    }

                    MessageBox(PEER_STR.del, text, [PEER_STR.delBtn, PEER_STR.cancel], [async () => {
                        const fd = new FormData();
                        fd.set("hash", {$csrfToken});
                        fd.set("sel", PEER_SEL);
                        fd.set("act", "delete");
                        fd.set("for_all", document.getElementById("im_peer_delete_for_all")?.checked ? "1" : "0");

                        const res = await fetch("/im/api/dialogs/action.json", { method: "POST", body: fd });
                        if(!res.ok) return fastError(tr("messages_error_1"));

                        window.router.navigate("/im");
                    }, Function.noop]);
                };

                const askLeave = () => {
                    close();
                    MessageBox(PEER_STR.leave, PEER_STR.leaveText.replace("%NAME%", escapeHtml(info.name)), [PEER_STR.leaveBtn, PEER_STR.cancel], [async () => {
                        const fd = new FormData();
                        fd.set("hash", {$csrfToken});

                        const res = await fetch(`/im/api/chat${ PEER_SEL }/leave.json`, { method: "POST", body: fd });
                        if(!res.ok) return fastError(tr("messages_error_1"));

                        window.router.navigate("/im");
                    }, Function.noop]);
                };

                const toggleBlock = row => {
                    const call = async method => {
                        try {
                            await window.OVKAPI.call(method, { owner_id: info.peer_id });
                            info.blocked = !info.blocked;
                            row.querySelector("span").textContent = info.blocked ? PEER_STR.unblock : PEER_STR.block;
                        } catch(e) {
                            fastError(e.message);
                        }
                    };

                    if(info.blocked) return call("account.unban");

                    close();
                    MessageBox(PEER_STR.blockTitle, escapeHtml(PEER_STR.blockText.replace("%NAME%", info.name)), [PEER_STR.yes, PEER_STR.no], [
                        () => call("account.ban"),
                        Function.noop,
                    ]);
                };

                body.addEventListener("click", e => {
                    if(e.target.closest('[data-act="add-members"]')) {
                        close();
                        return openAddMembers();
                    }

                    const row = e.target.closest(".im-peer-row[data-kind]");
                    if(row) return showKind(row.dataset.kind, row.dataset.title);

                    const act = e.target.closest(".im-peer-row[data-act]");
                    if(act) {
                        if(act.dataset.act === "search") return showSearch();

                        if(act.dataset.act === "leave") return askLeave();

                        return act.dataset.act === "delete" ? askDelete() : toggleBlock(act);
                    }

                    const message = e.target.closest(".im-search-msg[data-uuid]");
                    if(message) {
                        close();
                        return window.Msg.goToMessage(Number(message.dataset.uuid));
                    }

                    const photo = e.target.closest(".im-peer-att--photo[data-id]");
                    if(photo) {
                        e.preventDefault();
                        close();
                        return OpenMiniature(e, photo.dataset.url, null, photo.dataset.id, null);
                    }

                    const video = e.target.closest(".im-peer-att--video");
                    if(video) {
                        close();
                        return OpenVideo(video.dataset.id.split("_"));
                    }
                });

                if(page === "search") showSearch();
            };

            document.querySelector(".im-peer-info-btn")?.addEventListener("click", e => {
                e.preventDefault();
                openPeerInfo();
            });

            // лупа в хедере открывает то же окно сразу на поиске по сообщениям
            document.querySelector(".im-search-btn")?.addEventListener("click", e => {
                e.preventDefault();
                openPeerInfo("search");
            });

            // переход к дате переписки; дни без сообщений в календаре погашены
            const openCalendar = (message = window.Msg.firstVisibleMessage()) => {
                openCalendarModal({
                    title:       {tr("messenger_go_to_date")},
                    locale:      MSG_LOCALE,
                    initialDate: message && typeof message.timing.ts === "number" ? new Date(message.timing.ts * 1000) : new Date(),
                    loadMonth:   async (year, month) => {
                        const from = Math.floor(new Date(year, month, 1).getTime() / 1000);
                        const to   = Math.floor(new Date(year, month + 1, 1).getTime() / 1000);
                        const tz   = -new Date(year, month, 15).getTimezoneOffset();
                        const res  = await (await fetch(`/im/api/messages${ PEER_SEL }/calendar.json?from=${ from }&to=${ to }&tz=${ tz }`)).json();

                        // сервер считает номера суток от эпохи уже по местному времени
                        const days = res.days
                            .map(day => new Date(day * 86400000))
                            .filter(day => day.getUTCFullYear() === year && day.getUTCMonth() === month)
                            .map(day => day.getUTCDate());

                        return {
                            days,
                            min: res.first ? new Date(res.first * 1000) : null,
                            max: res.last ? new Date(res.last * 1000) : null,
                        };
                    },
                    onSelectDate: date => window.Msg.jump({ date: Math.floor(date.getTime() / 1000) }),
                });
            };

            document.querySelector(".im-calendar-btn")?.addEventListener("click", e => {
                e.preventDefault();
                openCalendar();
            });

            // календарь открывается и по нажатию на дату над сообщениями: плавающую или разделитель дня
            document.querySelector(".messenger-app--messages")?.addEventListener("click", e => {
                if(e.target.closest(".im_floating_date_wrap.shown b")) return openCalendar();

                const divider = e.target.closest(".messenger-app--messages-day-time b");
                if(divider) openCalendar(ko.dataFor(divider));
            });

            // экран загрузки снимается, когда лента готова; при переходе к сообщению — после перехода
            Promise.resolve(window.Msg.takeJump()).finally(() => {
                const app = document.querySelector(".messenger-app");
                app?.classList.remove("im-loading");
                app?.querySelector(".im-chat-loader")?.remove();
            });

            // Esc возвращает из чата к списку диалогов, как в Telegram: сначала он снимает выделение, ответ и пересылку,
            // а открытые окна, просмотрщик и меню закрывает сам. Чтобы не потерять черновик, с текстом в поле ввода не уходим
            const appEl = window.Msg.appEl;
            let escOwned = false;

            // до остальных обработчиков: окно могло закрыться этим же нажатием
            const onEscCapture = e => {
                if(e.key === "Escape") escOwned = (window.messagebox_stack?.length ?? 0) > 0 || document.body.classList.contains("dimmed") || !!document.querySelector("[data-tippy-root]");
            };

            const onEsc = e => {
                if(!document.body.contains(appEl)) {
                    window.removeEventListener("keydown", onEscCapture, true);
                    return window.removeEventListener("keydown", onEsc);
                }
                if(e.key !== "Escape" || e.repeat || e.defaultPrevented || escOwned) return;

                if(window.selectedMsgs().length) return window.selectedMsgs.removeAll();
                if(window.replyTo()) return window.Msg.clearReply();
                if(window.forwardMsgs().length) return window.Msg.clearForward();

                const field = e.target.closest?.("input, textarea, select, [contenteditable]");
                const ta    = document.querySelector("textarea[name=message]");
                if(field && field !== ta) return;
                if((ta && ta.value.trim() !== "") || document.querySelector("#write [data-att-id]")) return;

                e.preventDefault();
                window.router ? window.router.navigate("/im") : location.assign("/im");
            };

            window.addEventListener("keydown", onEscCapture, true);
            window.addEventListener("keydown", onEsc);
        })();
    </script>
{/block}
