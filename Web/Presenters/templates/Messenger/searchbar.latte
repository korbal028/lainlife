{* поиск по всем чатам, над списком диалогов и на странице результатов; open — поиск уже открыт *}
<form n:class="im-search-bar, ($open ?? false) ? open" action="/im/search" method="get">
    <div class="im-search-bar--field">
        <input type="search" name="q" value="{$query ?? ''}" placeholder="{_messenger_search_placeholder}" autocomplete="off" />
        <button type="button" class="im-search-bar--close" title="{_close}" aria-label="{_close}"></button>
    </div>
</form>

<script>

    (() => {
        const init = () => {
            const form = document.querySelector(".im-search-bar");
            const live = document.querySelector(".im-search-live");
            if(!form || !live) return;

            const input   = form.querySelector('input[type="search"]');
            const cross   = form.querySelector(".im-search-bar--close");
            const dialogs = document.querySelector(".im-dialogs"); // список чатов на /im, на странице поиска его нет
            const initial = location.pathname + location.search;

            // вкладка, выбранная вручную; без неё раздел выбирает сервер
            let section = new URLSearchParams(location.search).get("section");
            let last    = form.classList.contains("open") ? input.value.trim() : null;
            let timer   = null;
            let abort   = null;
            let version = 0;
            let loading = false;

            const searchUrl = (base, q) => {
                const params = new URLSearchParams();
                if(q !== "") params.set("q", q);
                if(section) params.set("section", section);

                return base + (params.toString() ? "?" + params : "");
            };

            const nearBottom = () => window.innerHeight + window.scrollY > document.documentElement.scrollHeight - 300;

            const loadMore = async () => {
                const page = live.querySelector(".im-search-page");
                if(live.hidden || loading || !page?.dataset.next) return;

                const current = version;
                loading = true;

                try {
                    const res = await fetch(page.dataset.next);
                    if(!res.ok) throw new Error(res.status);
                    const next = new DOMParser().parseFromString(await res.text(), "text/html");

                    if(current === version) {
                        page.querySelector("[data-items]")?.append(...(next.querySelector("[data-items]")?.children ?? []));
                        page.dataset.next = next.querySelector(".im-search-page")?.dataset.next ?? "";
                    }
                } catch(e) {
                    page.dataset.next = "";
                    console.error("Search page loading failed", e);
                }

                loading = false;
                if(current === version && nearBottom()) loadMore();
            };

            const update = async (force = false) => {
                clearTimeout(timer);

                const q = input.value.trim();
                if(q === last && !force) return;

                if(q !== last && q !== "" && section !== "chats" && section !== "messages") section = null;
                last = q;

                abort?.abort();
                abort = new AbortController();
                const current = ++version;
                live.classList.add("loading");

                try {
                    const res = await fetch(searchUrl("/im/api/search", q), { signal: abort.signal });
                    if(!res.ok) throw new Error(res.status);
                    const html = await res.text();
                    if(current !== version) return;

                    live.innerHTML = html;
                    history.replaceState(history.state, "", q === "" && !section && dialogs ? initial : searchUrl("/im/search", q));
                    if(nearBottom()) loadMore();
                } catch(e) {
                    if(e.name !== "AbortError") console.error("Search failed", e);
                }

                if(current === version) live.classList.remove("loading");
            };

            const open = () => {
                if(form.classList.contains("open")) return;

                form.classList.add("open");
                live.hidden = false;
                if(dialogs) dialogs.hidden = true;
                update(true);
            };

            const close = () => {
                if(!dialogs) return window.router ? window.router.navigate("/im") : location.assign("/im");

                clearTimeout(timer);
                abort?.abort();
                ++version;

                input.value = "";
                input.blur();
                section = null;
                last    = null;

                form.classList.remove("open");
                live.hidden = true;
                live.innerHTML = "";
                live.classList.remove("loading");
                dialogs.hidden = false;
                history.replaceState(history.state, "", initial);
            };

            input.addEventListener("focus", open);

            input.addEventListener("input", () => {
                open();
                clearTimeout(timer);
                timer = setTimeout(update, 300);
            });

            input.addEventListener("keydown", e => {
                if(e.key !== "Escape") return;

                e.preventDefault();
                close();
            });

            // без этого нажатие на крестик сначала уводит фокус с поля
            cross.addEventListener("mousedown", e => e.preventDefault());
            cross.addEventListener("click", close);

            form.addEventListener("submit", e => {
                e.preventDefault();
                open();
                update();
            });

            const onScroll = () => {
                if(!document.body.contains(form)) return window.removeEventListener("scroll", onScroll);
                if(nearBottom()) loadMore();
            };
            window.addEventListener("scroll", onScroll, { passive: true });
            if(nearBottom()) loadMore();

            live.addEventListener("click", e => {
                const tab = e.target.closest(".im-search-tabs a[data-section]");
                if(tab) {
                    e.preventDefault();
                    if(tab.closest("#activetabs")) return;

                    section = tab.dataset.section;
                    live.querySelectorAll(".im-search-tabs [id]").forEach(el => el.removeAttribute("id"));
                    tab.parentElement.id = "activetabs";
                    tab.id = "act_tab_a";
                    return update(true);
                }

                const photo = e.target.closest(".im-peer-att--photo[data-id]");
                if(photo) {
                    e.preventDefault();
                    return OpenMiniature(e, photo.dataset.url, null, photo.dataset.id, null);
                }

                const video = e.target.closest(".im-peer-att--video[data-id]");
                if(video) {
                    e.preventDefault();
                    return OpenVideo(video.dataset.id.split("_"));
                }
            });
        };

        document.readyState === "loading" ? document.addEventListener("DOMContentLoaded", init, { once: true }) : init();
    })();
</script>
