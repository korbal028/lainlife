{extends "../@layout.latte"}
{block title}Создать беседу{/block}
{block header}Создать беседу{/block}

{block wrap}
    <div style="padding: 10px;">
        <form method="post" action="/convs/create">
            <input type="hidden" name="hash" value="{$csrfToken}" />
            <div style="margin-bottom: 10px;">
                <label>Название беседы:</label><br/>
                <input type="text" name="name" placeholder="Введите название" style="width: 300px;" />
            </div>
            <button type="submit" class="button">Создать</button>
            <a href="/convs" style="margin-left: 10px;">Отмена</a>
        </form>
    </div>
{/block}
