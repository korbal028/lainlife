{extends "../@layout.latte"}
{block title}Настройки беседы{/block}
{block header}Настройки: {$conv->getName()}{/block}

{block wrap}
    <div style="padding: 10px;">
        <form method="post">
            <input type="hidden" name="hash" value="{$csrfToken}" />
            <div style="margin-bottom: 10px;">
                <label>Название беседы:</label><br/>
                <input type="text" name="name" value="{$conv->getName()}" style="width: 300px;" />
            </div>
            <button type="submit" class="button">Сохранить</button>
        </form>

        <hr style="margin: 20px 0;" />
        <h3>Участники ({count($conv->getMembers())})</h3>
        {foreach $conv->getMembers() as $member}
            <div style="display: flex; align-items: center; gap: 8px; padding: 5px;">
                <img src="{$member->getAvatarUrl('miniscule')}" style="width: 32px; height: 32px; border-radius: 50%;" />
                <a href="{$member->getURL()}">{$member->getCanonicalName()}</a>
            </div>
        {/foreach}

        <hr style="margin: 20px 0;" />
        <h3>Добавить участника</h3>
        <div style="display: flex; gap: 8px;">
            <input type="number" id="add-member-id" placeholder="ID пользователя" style="width: 200px;" />
            <button class="button" onclick="addMember()">Добавить</button>
        </div>
	<div id="conv-data" data-id="{$conv->getId()}" data-hash="{$csrfToken}" style="display:none;"></div>
        <script>
	function addMember() {
	    let userId = document.getElementById("add-member-id").value;
	    if(!userId) return;
	    let convData = document.getElementById("conv-data");
	    let fd = new FormData();
	    fd.set("user_id", userId);
	    fd.set("hash", convData.getAttribute("data-hash"));
	    fetch("/convs/api/" + convData.getAttribute("data-id") + "/add-member.json", { method: "POST", body: fd })
	        .then(r => { if(r.ok) location.reload(); else alert("Ошибка"); });
}
        </script>
    </div>
{/block}
