{extends "../@layout.latte"}
{block title}Мои беседы{/block}
{block header}Мои беседы{/block}

{block content}
    <div style="padding: 10px;">
        <a href="/convs/create" class="button" style="margin-bottom: 10px; display: inline-block;">+ Создать беседу</a>

        {if count($convs) === 0}
            <div style="color: #999; padding: 20px;">У вас нет бесед.</div>
        {else}
            {foreach $convs as $conv}
                <div style="display: flex; align-items: center; gap: 10px; padding: 8px; border-bottom: 1px solid #eee;">
                    <img src="{$conv->getAvatarUrl()}" style="width: 48px; height: 48px; border-radius: 50%;" />
                    <div>
                        <a href="/convs/{$conv->getId()}"><strong>{$conv->getName()}</strong></a>
                        <div style="font-size: 11px; color: #999;">{count($conv->getMembers())} участников</div>
                    </div>
                </div>
            {/foreach}
        {/if}
    </div>
{/block}
