SELECT COUNT(*) AS cnt FROM
(
  SELECT
    dt.id
  FROM
  (
    (
      SELECT
        id AS mid,
        recipient_id AS id,
        recipient_type AS class
      FROM messages
      WHERE
        sender_id = ?
      AND
        sender_type = ?
      AND
        deleted = 0
    ) UNION ALL (
      SELECT
        id AS mid,
        sender_id AS id,
        sender_type AS class
      FROM messages
      WHERE
        recipient_id = ?
      AND
        recipient_type = ?
      AND
        deleted = 0
    )
  ) dt
  LEFT JOIN messenger_dialogs d
    ON d.owner_id = ?
    AND d.owner_type = ?
    AND d.peer_id = dt.id
    AND d.peer_type = dt.class
  WHERE
    dt.mid > COALESCE(d.cleared_till, 0)
  AND
    COALESCE(d.archived, 0) = ?
  GROUP BY
    dt.id,
    dt.class
) cnt
